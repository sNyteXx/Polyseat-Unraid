# Polyseat - MangoHud's OpenGL shim, with one patch.
#
# Only the shim, built from MangoHud's release for both word lengths, next to
# the distribution's own MangoHud rather than over it. See README.md next to
# this file for what the patch does and why a seat needs it.
#
# Built with build.sh, which is the only supported way: a seat has no compiler,
# and gets the finished package rather than this recipe.

pkgname=polyseat-mangohud-shim
pkgver=0.8.4
pkgrel=1
pkgdesc="MangoHud's OpenGL shim for Polyseat seats, patched to work beside Steam's overlay"
arch=('x86_64')
url="https://github.com/superuser404notfound/Polyseat"
license=('MIT')

# The shim loads libMangoHud_opengl.so from its own directory, and that file is
# a link into these two.
depends=('mangohud' 'lib32-mangohud')
makedepends=('gcc' 'lib32-glibc' 'lib32-gcc-libs')

source=(
  "MangoHud-$pkgver.tar.gz::https://github.com/flightlessmango/MangoHud/archive/refs/tags/v$pkgver.tar.gz"
  'shim-rtld-next.patch'
)
sha256sums=(
  '0f79671dbc825f33d7014088cb7750c166934ade26bbd6007a171aa2d960cd2f'
  'SKIP'
)

prepare() {
  cd "MangoHud-$pkgver"
  patch -Np1 -i "$srcdir/shim-rtld-next.patch"
}

# The three files and the defines MangoHud's own meson.build compiles the shim
# from, and nothing else of MangoHud: the shim links against libc alone.
build() {
  cd "MangoHud-$pkgver"
  for bits in 64 32; do
    # shellcheck disable=SC2086
    gcc -m$bits $CFLAGS $LDFLAGS -shared -fPIC \
      -D_GNU_SOURCE -DHAVE_X11 -Isrc -Iinclude \
      -o "$srcdir/libMangoHud_shim.so.$bits" \
      src/gl/shim.c src/real_dlsym.c src/elfhacks.c -ldl
  done
}

package() {
  install -Dm755 "$srcdir/libMangoHud_shim.so.64" "$pkgdir/usr/lib/polyseat/mangohud/libMangoHud_shim.so"
  install -Dm755 "$srcdir/libMangoHud_shim.so.32" "$pkgdir/usr/lib32/polyseat/mangohud/libMangoHud_shim.so"

  # Relative, because a native game from Steam runs in the Steam Linux Runtime's
  # container, where the seat's /usr is /run/host/usr. An absolute link there
  # points into the runtime, finds nothing, and the game runs uncapped.
  ln -s ../../mangohud/libMangoHud_opengl.so "$pkgdir/usr/lib/polyseat/mangohud/libMangoHud_opengl.so"
  ln -s ../../mangohud/libMangoHud_opengl.so "$pkgdir/usr/lib32/polyseat/mangohud/libMangoHud_opengl.so"

  install -Dm644 "MangoHud-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
