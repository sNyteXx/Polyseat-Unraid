<?PHP
/* Read-only status page. It runs one fixed, read-only controller command and
 * never passes user input to a shell. Changing state stays CLI/PLG-only until
 * the acceptance gates are met; see the plugin README. */
$ctl = '/usr/local/emhttp/plugins/polyseat-unraid/scripts/polyseatctl';
$raw = is_executable($ctl) ? shell_exec($ctl.' status --json 2>/dev/null') : null;
$st  = $raw ? json_decode($raw, true) : null;
function e($v) { return htmlspecialchars((string)($v ?? ''), ENT_QUOTES, 'UTF-8'); }
?>
<div style="margin-bottom:1em"><b>WIP</b> &mdash; Polyseat for Unraid is experimental. This page is read-only.</div>
<table class="tablesorter">
<tr><td>State</td><td><?=e($st['state'] ?? 'unavailable')?></td></tr>
<tr><td>Bundle version</td><td><?=e($st['version'] ?? '')?></td></tr>
<tr><td>Active bundle</td><td><code><?=e($st['current'] ?? '')?></code></td></tr>
<tr><td>Previous bundle</td><td><code><?=e($st['previous'] ?? '')?></code></td></tr>
<tr><td>Data directory</td><td><?=e($st['data_dir'] ?? '')?></td></tr>
<tr><td>Controller</td><td><?=e($st['controller'] ?? '')?> (release gate: <?=e($st['release_gate'] ?? '')?>)</td></tr>
</table>
<p>Use <code>polyseatctl status|health|diagnose</code> on the console for details.</p>
