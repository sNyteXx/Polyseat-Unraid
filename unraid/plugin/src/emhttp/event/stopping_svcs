#!/bin/bash
# Array is stopping: end a play session cleanly, then stop instances and the daemon, before pools unmount.
# A running session is asked to stop and waited for (bounded): its seats stop in upstream's order, Incus records a
# clean stop and the host is restored (sysrq, console keyboard, udev rule, energy profile) while the pools are still there.
# Only after that, or after the bound, the emergency stop runs, exactly as before.
CTL=/usr/local/emhttp/plugins/polyseat-unraid/scripts/polyseatctl
[[ -x $CTL ]] || exit 0
"$CTL" play-stop --wait 300 > /dev/null 2>&1
"$CTL" stop > /dev/null 2>&1
exit 0
