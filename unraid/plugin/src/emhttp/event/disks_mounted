#!/bin/bash
# Array and pools are mounted: rebuild the RAM runtime from flash and start the
# service if the user enabled it. Runs in the background so array start is not delayed.
CTL=/usr/local/emhttp/plugins/polyseat-unraid/scripts/polyseatctl
[[ -x $CTL ]] || exit 0
( setsid "$CTL" boot > /dev/null 2>&1 < /dev/null & )
exit 0
