#!/bin/bash
# Array and pools are mounted: rebuild the RAM runtime from flash and start the
# service if the user enabled it. Runs in the background so array start is not delayed.
# An owner-mode controller (owner decision 2026-11-01) starts nothing here: "boot" only verifies the bundle on the
# flash and logs. A play session is started from the WebUI, never here. The one thing "boot" starts by itself in an owner
# build is the permanent workloads daemon, and only when WORKLOADS_ENABLED=yes (detached, with its own prechecks).
CTL=/usr/local/emhttp/plugins/polyseat-unraid/scripts/polyseatctl
[[ -x $CTL ]] || exit 0
( setsid "$CTL" boot > /dev/null 2>&1 < /dev/null & )
exit 0
