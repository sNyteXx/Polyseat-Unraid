#!/bin/bash
# polyseatctl - Polyseat/Incus runtime controller for Unraid.
#
# WIP / DO NOT USE: every mutating command is refused on a real host while
# POLYSEAT_RELEASE_GATE is "closed" (the committed value). The only other way
# to mutate is the private sandbox mode (POLYSEAT_ROOT=/tmp/polyseat-ctl-*),
# which itself refuses to run on Unraid.
#
# Dependencies on the host: bash, jq, tar, gzip, sha256sum, flock, ssh-keygen,
# ldconfig, getconf. No Python, no systemd, no package manager.
#
# Design rules: no recursive deletion (only exact, manifest-listed paths),
# nothing is trusted before signature+checksum+listing checks, live state is
# switched by one atomic rename behind a fsynced journal, failures fail closed.

set -u -o pipefail
umask 077

POLYSEAT_RELEASE_GATE="closed"   # closed | test-host | canary | open (release rendering only)
CTL_VERSION="0.1.0-wip"
PLUGIN="polyseat-unraid"
SIGN_IDENTITY="polyseat-unraid-release"
SIGN_NAMESPACE="polyseat-unraid-bundle"
DISPOSABLE_MARKER_TEXT="polyseat-unraid-disposable-test-host-v1"

MAX_ARCHIVE_BYTES=$((256 * 1024 * 1024))
MAX_TOTAL_BYTES=$((512 * 1024 * 1024))
SAFE_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
SHA_RE='^[0-9a-f]{64}$'
CANARY_CGROUP="/sys/fs/cgroup/polyseat-unraid-canary"
CANARY_CPUSET="24-27"  # E-cores on Tower; never inherit a host-wide CPU set
CANARY_HOST_CPUSET="0-27"  # verified read-only on Tower; CI fixtures may override
CANARY_CPU_MAX="100000 1000000"  # 10% of one CPU
CANARY_MEMORY_MAX=536870912
CANARY_PIDS_MAX=256
CANARY_WATCHDOG_CGROUP="/sys/fs/cgroup/polyseat-unraid-canary-watchdog"
CANARY_WATCHDOG_MEMORY_MAX=33554432
CANARY_DATA_DIR="/var/lib/polyseat-unraid-canary"
CANARY_DATA_MAX_KB=262144  # monitored abort threshold, NOT a filesystem quota
CANARY_LOG_MAX_BYTES=16777216  # likewise, one-second monitoring may overshoot
CANARY_HOST_MIN_AVAILABLE_KB=4194304
CANARY_HOST_MAX_LOAD=14
CANARY_HEALTH_TIMEOUT=60  # fixed: identical in the CI rehearsal and on Tower, never read from user settings
# Incus 7.5.1 cmd/incusd/main_daemon.go `neededPrograms`: the daemon exits unless each one resolves on PATH.
# The build fails if this list and the pinned source drift apart (unraid/scripts/lib/build-core.sh).
INCUSD_REQUIRED_PROGRAMS="ip rsync setfattr tar unsquashfs xz"
CANARY_SIGN_IDENTITY="polyseat-unraid-canary-approver"
CANARY_SIGN_NAMESPACE="polyseat-unraid-canary-approval-v1"

EX_USAGE=1 EX_BLOCKED=2 EX_CORRUPT=3 EX_HEALTH=4 EX_VERIFY=5 EX_SPACE=6 EX_PENDING=7

LOG_ENABLED=0
LOCK_HELD=0
APPROVED=0
CANARY_OPERATION=0
CANARY_HEALTH_DEADLINE=0
CANARY_RUN_OWNED=0

# ---------------------------------------------------------------- paths ----
init_paths() {
  ROOT="${POLYSEAT_ROOT:-}"
  FLASH_DIR="$ROOT/boot/config/plugins/$PLUGIN"
  CFG="$FLASH_DIR/$PLUGIN.cfg"
  BUNDLE_DIR="$FLASH_DIR/bundles"
  STATE_DIR="$FLASH_DIR/state"
  SIGNERS="$FLASH_DIR/allowed_signers"
  REVOKED="$FLASH_DIR/revoked_keys"
  CANARY_SIGNERS="$FLASH_DIR/canary_allowed_signers"
  CANARY_APPROVAL="$FLASH_DIR/canary-approval.json"
  MARKER="$FLASH_DIR/DISPOSABLE_TEST_HOST"
  RAM_DIR="$ROOT/usr/local/$PLUGIN"
  SLOTS="$RAM_DIR/slots"
  CURRENT="$RAM_DIR/current"
  RUN_DIR="$ROOT/var/run/$PLUGIN"
  CANARY_SESSION="$RUN_DIR/canary-session.json"
  LOG_DIR="$ROOT/var/log/$PLUGIN"
  SUBID_DIR="$ROOT/etc"
  # A real daemon reads /etc/subuid, probes /sys and uses absolute compiled-in paths, none of which a
  # sandbox root can redirect. Only a sandbox on a disposable GitHub-hosted runner may address the
  # runner's real system, and only when the CI job asks for it explicitly.
  if ci_real_system; then SUBID_DIR=/etc; fi
  UNRAID_VERSION_FILE="$ROOT/etc/unraid-version"
  SCHEMA="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../schema.json"
  PIDFILE="$RUN_DIR/incusd.pid"
  LOCKFILE="$RUN_DIR/lock"
}

sandbox() { [[ -n "$ROOT" ]]; }

ci_real_system() {
  [[ -n $ROOT && ${POLYSEAT_CI_REAL_SYSTEM:-} == 1 && ${CI:-} == true && ${GITHUB_ACTIONS:-} == true &&
     ${RUNNER_ENVIRONMENT:-} == github-hosted && ! -e /etc/unraid-version ]]
}

# ------------------------------------------------------------- logging ----
log() {
  local level=$1 msg=$2 line
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) [$level] $msg"
  if [[ $LOG_ENABLED -eq 1 ]]; then
    local file="$LOG_DIR/$PLUGIN.log"
    if [[ -f $file && ! -L $file ]] && [[ $(stat -c %s "$file" 2>/dev/null || echo 0) -gt 1048576 ]]; then
      mv -f -- "$file" "$file.1"
    fi
    if [[ ! -L $file ]]; then
      printf '%s\n' "$line" >> "$file"
    fi
    if ! sandbox && command -v logger >/dev/null 2>&1; then
      logger -t "$PLUGIN" -- "[$level] $msg" || true
    fi
  fi
  [[ $level == debug ]] || printf '%s\n' "$line" >&2
}

die() {
  local code=$1
  shift
  log error "$*"
  exit "$code"
}

crash_point() {
  if sandbox && [[ ${POLYSEAT_CRASH_AT:-} == "$1" ]]; then
    exit 99
  fi
}

# ------------------------------------------------------------- helpers ----
version_ge() { # $1 >= $2
  [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" == "$2" ]]
}

fs_type() { stat -f -c %T -- "$1" 2>/dev/null || echo unknown; }

fs_has_perms() {
  case "$(fs_type "$1")" in
    vfat | msdos | exfat | fuseblk | ntfs | unknown) return 1 ;;
    *) return 0 ;;
  esac
}

sync_path() { sync -f -- "$1" 2>/dev/null || sync; }

free_kb() {
  if sandbox && [[ -n ${POLYSEAT_FAKE_FREE_KB:-} ]]; then
    printf '%s\n' "$POLYSEAT_FAKE_FREE_KB"
    return
  fi
  df -Pk -- "$1" | awk 'NR==2 {print $4}'
}

check_private_file() { # regular, not a symlink, owned by us, no group/other access
  local f=$1 mode owner
  [[ -f $f && ! -L $f ]] || return 1
  fs_has_perms "$f" || return 0
  owner=$(stat -c %u -- "$f") || return 1
  mode=$(stat -c %a -- "$f") || return 1
  [[ $owner == "$(id -u)" ]] || return 1
  (( (8#$mode & 8#077) == 0 ))
}

write_json_atomic() { # path json-text
  local path=$1 text=$2 dir tmp
  dir=$(dirname -- "$path")
  tmp=$(mktemp "$dir/.txn-XXXXXX") || return 1
  if ! printf '%s\n' "$text" | jq -c -S . > "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  sync_path "$tmp"
  mv -T -- "$tmp" "$path" || { rm -f -- "$tmp"; return 1; }
  sync_path "$dir"
}

cfg_get() { # KEY fallback : user setting, else schema default, else fallback
  local key=$1 fallback=$2 value="" have=0
  if [[ -f $CFG && ! -L $CFG ]]; then
    value=$(awk -F= -v k="$key" '$1==k { v=$2; gsub(/^"|"$/, "", v); print v; found=1; exit } END { exit !found }' "$CFG") && have=1
  fi
  if [[ $have -eq 0 && -f $SCHEMA ]]; then
    value=$(jq -r --arg k "$key" '.[$k].default // empty' "$SCHEMA" 2>/dev/null || true)
    [[ -n $value ]] && have=1
  fi
  if [[ $have -eq 1 && -n $value ]]; then printf '%s\n' "$value"; else printf '%s\n' "$fallback"; fi
}

# Validate one KEY=VALUE against schema.json (the single source of truth shared with the WebUI).
schema_validate() { # key value
  # The one-shot canary has a separate, fixed RAM-root workspace. Never widen
  # the ordinary pool-path schema or accept arbitrary /var paths.
  if [[ $POLYSEAT_RELEASE_GATE == canary && $1 == DATA_DIR ]]; then
    [[ $2 == "$CANARY_DATA_DIR" ]]; return
  fi
  [[ -f $SCHEMA ]] || return 1
  jq -e --arg k "$1" --arg v "$2" '
    .[$k] as $s
    | $s != null and (
        if $s.type=="enum" then ($s.values | index($v)) != null
        elif $s.type=="int" then ($v|test("^[0-9]{1,10}$")) and (($v|tonumber) >= $s.min) and (($v|tonumber) <= $s.max)
        elif $s.type=="path" then ($v=="" or ($v|test($s.pattern)))
        else false end)' "$SCHEMA" >/dev/null 2>&1
}

# ---------------------------------------------------------------- gate ----
canary_host_sha256() {
  local uuid
  [[ -r /sys/class/dmi/id/product_uuid ]] || return 1
  uuid=$(< /sys/class/dmi/id/product_uuid)
  [[ $uuid =~ ^[0-9A-Fa-f-]{36}$ ]] || return 1
  printf '%s' "${uuid,,}" | sha256sum | awk '{print $1}'
}

canary_approval_for() { # command args... (root only, non-sandbox)
  local action=$1 token_sha target="" now host_sha
  shift
  [[ -f $CANARY_APPROVAL && ! -L $CANARY_APPROVAL &&
     -f $CANARY_APPROVAL.sig && ! -L $CANARY_APPROVAL.sig &&
     -f $CANARY_SIGNERS && ! -L $CANARY_SIGNERS ]] ||
    die $EX_BLOCKED "canary approval/signature/allowlist missing"
  if ! check_private_file "$CANARY_APPROVAL" || ! check_private_file "$CANARY_APPROVAL.sig"; then
    die $EX_BLOCKED "canary approval and signature must be owner-private files"
  fi
  local -a revoke=()
  if [[ -e $REVOKED || -L $REVOKED ]]; then
    [[ -f $REVOKED && ! -L $REVOKED ]] || die $EX_BLOCKED "invalid revocation list"
    revoke=(-r "$REVOKED")
  fi
  ssh-keygen -Y verify -f "$CANARY_SIGNERS" -I "$CANARY_SIGN_IDENTITY" \
    -n "$CANARY_SIGN_NAMESPACE" "${revoke[@]}" -s "$CANARY_APPROVAL.sig" \
    < "$CANARY_APPROVAL" >/dev/null 2>&1 ||
    die $EX_BLOCKED "canary approval signature invalid/revoked"
  now=$(date -u +%s)
  host_sha=$(canary_host_sha256) || die $EX_BLOCKED "cannot fingerprint canary host"
  jq -e --argjson now "$now" --arg host "$host_sha" --arg action "$action" '
    (keys | sort) == ["actions", "archive_sha256", "expires_at", "host_sha256", "issued_at", "schema"] and
    .schema == 1 and .host_sha256 == $host and
    (.archive_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    (.issued_at | type == "number" and . == floor) and
    (.expires_at | type == "number" and . == floor) and
    .issued_at <= $now and $now < .expires_at and
    (.expires_at - .issued_at) <= 1800 and
    (.actions | type == "array" and length <= 6 and length > 0 and
      (unique | length) == length and all(.[];
       . == "stage" or . == "activate" or . == "start" or . == "canary-smoke" or
       . == "config-set" or . == "config-reset")) and
    (.actions | index($action) != null)' "$CANARY_APPROVAL" >/dev/null 2>&1 ||
    die $EX_BLOCKED "canary approval expired, wrong host, invalid scope or bad schema"
  token_sha=$(jq -r .archive_sha256 "$CANARY_APPROVAL")
  case "$action" in
    stage)
      [[ -f ${1:-} && ! -L ${1:-} ]] || die $EX_BLOCKED "canary stage archive unavailable"
      target=$(sha256sum -- "$1" | awk '{print $1}') ;;
    activate) target=${1:-} ;;
    start | canary-smoke)
      read_pointer
      target=$PTR_CURRENT ;;
    config-set | config-reset)
      # The canary must never become an unattended boot service.
      if [[ $action == config-set ]]; then
        local arg
        for arg in "$@"; do
          case "$arg" in
            SERVICE=disabled | "DATA_DIR=$CANARY_DATA_DIR" | ACCEPT_NO_LSM=yes | ACCEPT_NO_LSM=no) ;;
            *) die $EX_BLOCKED "canary accepts only fixed DATA_DIR, disabled SERVICE and LSM acknowledgement" ;;
          esac
        done
      fi
      [[ -f $STATE_DIR/pointer.json ]] && { read_pointer; target=$PTR_CURRENT; }
      ;;
    *) die $EX_BLOCKED "canary action is outside the minimal test scope" ;;
  esac
  [[ -z $target || $target == "$token_sha" ]] ||
    die $EX_BLOCKED "canary approval is bound to another bundle SHA-256"
}

require_mutation_allowed() {
  if sandbox; then
    [[ $ROOT =~ ^/tmp/polyseat-ctl-[A-Za-z0-9_-]{6,}$ ]] ||
      die $EX_BLOCKED "sandbox root must be a direct /tmp/polyseat-ctl-* directory"
    [[ ! -e /etc/unraid-version ]] ||
      die $EX_BLOCKED "sandbox mode is refused on an Unraid host"
    [[ -d $ROOT && ! -L $ROOT && $(stat -c %u -- "$ROOT") == "$(id -u)" ]] ||
      die $EX_BLOCKED "sandbox root must be a real directory owned by the caller"
    case "$(stat -c %a -- "$ROOT")" in
      700 | 711) ;;
      *) die $EX_BLOCKED "sandbox root must have mode 0700 or 0711" ;;
    esac
    if [[ $POLYSEAT_RELEASE_GATE != canary ]]; then return 0; fi
    ci_real_system || die $EX_BLOCKED "real canary sandbox needs a disposable GitHub-hosted runner"
  fi
  case "$POLYSEAT_RELEASE_GATE" in
    open) ;;
    canary)
      [[ $(id -u) -eq 0 ]] || die $EX_BLOCKED "root required"
      case "${1:-}" in
        stop | uninstall | recover) ;;  # emergency teardown works even after expiry
        *) canary_approval_for "$@" ;;
      esac
      ;;
    test-host)
      [[ ! -e /etc/unraid-version ]] ||
        die $EX_BLOCKED "disposable test-host gate is forbidden on Unraid"
      [[ -f $MARKER && ! -L $MARKER && "$(head -n1 -- "$MARKER")" == "$DISPOSABLE_MARKER_TEXT" ]] ||
        die $EX_BLOCKED "test build: DISPOSABLE_TEST_HOST marker missing; refusing on this host"
      ;;
    *) die $EX_BLOCKED "WIP release gate is closed: host mutation refused" ;;
  esac
  [[ $(id -u) -eq 0 ]] || die $EX_BLOCKED "root required"
}

require_approval() {
  [[ $APPROVED -eq 1 ]] || die $EX_BLOCKED "explicit --approve required for '$1'"
}

acquire_lock() {
  [[ $LOCK_HELD -eq 1 ]] && return 0
  mkdir -p -- "$RUN_DIR" "$LOG_DIR" || die $EX_BLOCKED "cannot create runtime directories"
  LOG_ENABLED=1
  exec 9> "$LOCKFILE" || die $EX_BLOCKED "cannot open lock file"
  flock -w 120 9 || die $EX_PENDING "another polyseatctl operation is running"
  LOCK_HELD=1
}

# --------------------------------------------------------------- state ----
PTR_CURRENT=""
PTR_PREVIOUS=""
JR_PHASE=""
JR_TARGET=""
JR_PREVIOUS=""
JR_WAS_RUNNING=0

read_pointer() {
  local f="$STATE_DIR/pointer.json"
  PTR_CURRENT="" PTR_PREVIOUS=""
  if [[ ! -e $f && ! -L $f ]]; then
    return 0
  fi
  check_private_file "$f" || die $EX_CORRUPT "untrusted pointer state file"
  jq -e 'type=="object" and (keys==["current","previous"]) and
         all(.[]; .==null or (type=="string" and test("^[0-9a-f]{64}$")))' "$f" >/dev/null 2>&1 ||
    die $EX_CORRUPT "corrupt pointer state"
  PTR_CURRENT=$(jq -r '.current // ""' "$f")
  PTR_PREVIOUS=$(jq -r '.previous // ""' "$f")
}

write_pointer() { # current previous
  local c=$1 p=$2
  write_json_atomic "$STATE_DIR/pointer.json" \
    "$(jq -n --arg c "$c" --arg p "$p" '{current: (if $c=="" then null else $c end), previous: (if $p=="" then null else $p end)}')" ||
    die $EX_CORRUPT "cannot write pointer state"
}

read_journal() {
  local f="$STATE_DIR/journal.json"
  JR_PHASE="" JR_TARGET="" JR_PREVIOUS=""
  if [[ ! -e $f && ! -L $f ]]; then
    return 0
  fi
  check_private_file "$f" || die $EX_CORRUPT "untrusted journal file"
  jq -e 'type=="object" and (keys==["phase","previous","target","was_running"]) and
         (.phase=="activating" or .phase=="rolling-back") and (.was_running|type=="boolean") and
         all(.previous,.target; .==null or (type=="string" and test("^[0-9a-f]{64}$")))' "$f" >/dev/null 2>&1 ||
    die $EX_CORRUPT "corrupt transaction journal"
  JR_PHASE=$(jq -r '.phase' "$f")
  JR_WAS_RUNNING=$(jq -r 'if .was_running then 1 else 0 end' "$f")
  JR_TARGET=$(jq -r '.target // ""' "$f")
  JR_PREVIOUS=$(jq -r '.previous // ""' "$f")
}

write_journal() { # phase target previous was_running(0|1)
  write_json_atomic "$STATE_DIR/journal.json" \
    "$(jq -n --arg ph "$1" --arg t "$2" --arg p "$3" --argjson w "$4" \
      '{phase:$ph, target:(if $t=="" then null else $t end), previous:(if $p=="" then null else $p end), was_running:($w==1)}')" ||
    die $EX_CORRUPT "cannot write journal"
}

clear_journal() {
  rm -f -- "$STATE_DIR/journal.json"
  sync_path "$STATE_DIR"
}

require_no_journal() {
  read_journal
  [[ -z $JR_PHASE ]] || die $EX_PENDING "unfinished transaction ($JR_PHASE): run 'recover --approve' first"
}

ensure_state_dirs() {
  mkdir -p -- "$FLASH_DIR" "$BUNDLE_DIR" "$STATE_DIR" "$RAM_DIR" "$SLOTS" ||
    die $EX_BLOCKED "cannot create plugin directories"
}

# ------------------------------------------------------- bundle checks ----
BUNDLE_OVERRIDE_BASE=""

bundle_path() { # sha suffix
  if [[ -n $BUNDLE_OVERRIDE_BASE ]]; then
    printf '%s%s\n' "$BUNDLE_OVERRIDE_BASE" "$2"
  else
    printf '%s/%s%s\n' "$BUNDLE_DIR" "$1" "$2"
  fi
}
bundle_archive() { bundle_path "$1" .tar.gz; }
bundle_manifest() { bundle_path "$1" .manifest.json; }
bundle_sig() { bundle_path "$1" .manifest.json.sig; }

validate_manifest_file() { # manifest sha
  local manifest=$1 sha=$2
  jq -e --arg sha "$sha" '
    def ver: type=="string" and test("^[0-9][0-9A-Za-z.+_-]{0,40}$");
    (type=="object") and (.schema==1)
    and (.name|type=="string" and test("^[a-z][a-z0-9-]{1,40}$"))
    and (.version|ver) and (.incus_version|ver) and (.min_unraid|ver)
    and (.min_glibc|ver) and (.min_kernel|ver)
    and (.lxc_rootfs_mount=="/var/lib/polyseat-lxc/rootfs")
    and (.built_without|type=="array" and length<=2 and (unique|length)==length
         and all(.[]; .=="apparmor" or .=="selinux"))
    and (.archive_sha256==$sha)
    and (.needed_libs|type=="array" and length<=64 and all(.[]; type=="string" and test("^[A-Za-z0-9_.+-]+$")))
    and (.files|type=="array" and length>0 and length<=128)
    and all(.files[]; (keys==["mode","path","sha256","size"])
        and (.path|type=="string" and test("^payload(/[A-Za-z0-9_+-][A-Za-z0-9_.+-]*)+$"))
        and (.sha256|type=="string" and test("^[0-9a-f]{64}$"))
        and (.mode==420 or .mode==493)
        and (.size|type=="number" and .==floor and .>=0 and .<=536870912))
    and ((.files|map(.path)|length)==(.files|map(.path)|unique|length))
    and ((.files|map(.size)|add)<=536870912)
  ' "$manifest" >/dev/null 2>&1
}

verify_signature() { # manifest sig
  local manifest=$1 sig=$2
  if sandbox && [[ $POLYSEAT_RELEASE_GATE != canary && ${POLYSEAT_TEST_UNSIGNED:-} == 1 ]]; then
    log warn "TEST ONLY: signature check skipped (sandbox)"
    return 0
  fi
  [[ -f $SIGNERS && ! -L $SIGNERS && -f $sig && ! -L $sig ]] || return 1
  # An optional revocation list (public keys, one per line) is enforced; if it exists but is not a plain
  # regular file the check fails closed instead of silently ignoring it.
  local -a revoke=()
  if [[ -e $REVOKED || -L $REVOKED ]]; then
    [[ -f $REVOKED && ! -L $REVOKED ]] || return 1
    revoke=(-r "$REVOKED")
  fi
  ssh-keygen -Y verify -f "$SIGNERS" -I "$SIGN_IDENTITY" -n "$SIGN_NAMESPACE" "${revoke[@]}" \
    -s "$sig" < "$manifest" >/dev/null 2>&1
}

mode_to_octal() { # -rwxr-xr-x -> 755 ; anything unusual (setuid, sticky) -> empty
  local m=${1:1} out=0 i part
  [[ ${#1} -eq 10 && $m =~ ^[r-][w-][x-][r-][w-][x-][r-][w-][x-]$ ]] || return 1
  for i in 0 3 6; do
    part=0
    [[ ${m:i:1} == r ]] && part=$((part + 4))
    [[ ${m:i+1:1} == w ]] && part=$((part + 2))
    [[ ${m:i+2:1} == x ]] && part=$((part + 1))
    out=$((out * 8 + part))
  done
  printf '%o\n' "$out"
}

# Verify archive entries against the manifest WITHOUT extracting anything.
verify_archive_listing() { # archive manifest
  local archive=$1 manifest=$2 listing want got line mode_s owner size name mode total=0 want_mode want_size
  local -a lines
  listing=$(mktemp) || return 1
  if ! tar --quoting-style=escape --numeric-owner -tvzf "$archive" > "$listing" 2>/dev/null; then
    rm -f -- "$listing"
    return 1
  fi
  mapfile -t lines < "$listing"
  rm -f -- "$listing"
  want=$(jq -r '.files[].path' "$manifest" | sort)
  got=""
  for line in "${lines[@]}"; do
    mode_s=${line%% *}
    [[ ${mode_s:0:1} == "-" ]] || return 1
    owner=$(awk '{print $2}' <<< "$line")
    size=$(awk '{print $3}' <<< "$line")
    name=$(sed -E 's/^[^ ]+ +[^ ]+ +[0-9]+ +[0-9-]+ +[0-9:]+ //' <<< "$line")
    [[ $owner == "0/0" && $size =~ ^[0-9]+$ ]] || return 1
    [[ $name =~ ^payload(/[A-Za-z0-9_+-][A-Za-z0-9_.+-]*)+$ ]] || return 1
    mode=$(mode_to_octal "$mode_s") || return 1
    want_mode=$(jq -r --arg n "$name" '.files[]|select(.path==$n)|.mode' "$manifest")
    want_size=$(jq -r --arg n "$name" '.files[]|select(.path==$n)|.size' "$manifest")
    [[ -n $want_mode && $((8#$mode)) -eq $want_mode && $size -eq $want_size ]] || return 1
    total=$((total + size))
    got+="$name"$'\n'
  done
  [[ $total -le $MAX_TOTAL_BYTES ]] || return 1
  got=$(printf '%s' "$got" | sort)
  [[ "$got" == "$want" ]]   # exact set: no extras, no duplicates, nothing missing
}

# Full read-only verification of the three flash files of one bundle.
verify_bundle_files() { # sha
  local sha=$1 archive manifest sig actual
  [[ $sha =~ $SHA_RE ]] || return 1
  archive=$(bundle_archive "$sha") manifest=$(bundle_manifest "$sha") sig=$(bundle_sig "$sha")
  [[ -f $archive && ! -L $archive && -f $manifest && ! -L $manifest ]] || { log error "bundle $sha: files missing"; return 1; }
  [[ $(stat -c %s -- "$archive") -le $MAX_ARCHIVE_BYTES ]] || { log error "bundle $sha: archive too large"; return 1; }
  actual=$(sha256sum -- "$archive" | awk '{print $1}')
  [[ $actual == "$sha" ]] || { log error "bundle $sha: archive checksum mismatch"; return 1; }
  validate_manifest_file "$manifest" "$sha" || { log error "bundle $sha: manifest invalid"; return 1; }
  verify_signature "$manifest" "$sig" || { log error "bundle $sha: manifest signature invalid or untrusted"; return 1; }
  verify_archive_listing "$archive" "$manifest" || { log error "bundle $sha: archive contents differ from manifest"; return 1; }
  verify_archive_member_hashes "$archive" "$manifest" || { log error "bundle $sha: member checksums differ from manifest"; return 1; }
}

# One streaming pass over the archive; members are hashed on the fly and never written to disk.
verify_archive_member_hashes() { # archive manifest
  local archive=$1 manifest=$2 got want
  # shellcheck disable=SC2016  # expands in tar's own shell, per member
  got=$(tar -xzf "$archive" --to-command='printf "%s  %s\n" "$(sha256sum | cut -d" " -f1)" "$TAR_FILENAME"' 2>/dev/null | sort) || return 1
  want=$(jq -r '.files[] | "\(.sha256)  \(.path)"' "$manifest" | sort)
  [[ -n $got && "$got" == "$want" ]]
}

host_unraid_version() {
  [[ -r $UNRAID_VERSION_FILE ]] || return 1
  awk -F'"' '/^version=/ {print $2; exit}' "$UNRAID_VERSION_FILE"
}

check_host_compat() { # manifest
  local manifest=$1 unraid glibc kernel lib missing=0
  unraid=$(host_unraid_version) || { log error "cannot read Unraid version"; return 1; }
  version_ge "$unraid" "$(jq -r .min_unraid "$manifest")" || { log error "Unraid $unraid is older than required"; return 1; }
  glibc=$(getconf GNU_LIBC_VERSION | awk '{print $2}')
  version_ge "$glibc" "$(jq -r .min_glibc "$manifest")" || { log error "glibc $glibc is older than required"; return 1; }
  kernel=$(uname -r | sed -E 's/^([0-9]+\.[0-9]+).*/\1/')
  version_ge "$kernel" "$(jq -r .min_kernel "$manifest")" || { log error "kernel $kernel is older than required"; return 1; }
  while IFS= read -r lib; do
    if ! ldconfig -p 2>/dev/null | awk -v l="$lib" '$1==l && /x86-64/ {f=1} END {exit !f}'; then
      log error "required host library missing: $lib"
      missing=1
    fi
  done < <(jq -r '.needed_libs[]' "$manifest")
  [[ $missing -eq 0 ]]
}

# ---------------------------------------------------------------- slots ----
slot_dir() { printf '%s/%s\n' "$SLOTS" "$1"; }

expected_slot_listing() { # manifest
  jq -r '.files[].path' "$1" | awk '
    { print "f " $0; n=split($0, p, "/"); d=""; for (i=1; i<n; i++) { d = (d=="" ? p[i] : d "/" p[i]); print "d " d } }
    END { print "f slot.json" }' | sort -u
}

verify_slot() { # sha  (manifest must be on flash)
  local sha=$1 slot manifest expect actual mode path want
  slot=$(slot_dir "$sha") manifest=$(bundle_manifest "$sha")
  [[ -d $slot && ! -L $slot && -f $manifest ]] || return 1
  expect=$(expected_slot_listing "$manifest")
  actual=$(find "$slot" -mindepth 1 -printf '%y %P\n' | sort -u)
  [[ "$actual" == "$expect" ]] || return 1
  (cd "$slot" && jq -r '.files[] | "\(.sha256)  \(.path)"' "$manifest" | sha256sum --check --strict --quiet) >/dev/null 2>&1 || return 1
  while IFS=' ' read -r want path; do
    mode=$(stat -c %a -- "$slot/$path") || return 1
    [[ $mode == "$(printf '%o' "$want")" ]] || return 1
  done < <(jq -r '.files[] | "\(.mode) \(.path)"' "$manifest")
}

# Remove exactly the files a manifest lists (plus slot.json), then empty
# directories bottom-up. Never recursive; leftovers are reported, not deleted.
remove_slot_exact() { # sha
  local sha=$1 slot manifest path leftover=0
  slot=$(slot_dir "$sha")
  [[ -d $slot && ! -L $slot ]] || return 0
  manifest=$(bundle_manifest "$sha")
  if [[ ! -f $manifest ]]; then
    log warn "slot $sha left in place: manifest unavailable for exact removal"
    return 1
  fi
  while IFS= read -r path; do
    if [[ -f $slot/$path && ! -L $slot/$path ]]; then
      rm -f -- "$slot/$path"
    fi
  done < <(jq -r '.files[].path' "$manifest")
  rm -f -- "$slot/slot.json"
  while IFS= read -r path; do
    rmdir -- "$slot/$path" 2>/dev/null || leftover=1
  done < <(jq -r '.files[].path' "$manifest" | awk '
      { n=split($0,p,"/"); d=""; for (i=1;i<n;i++) { d=(d==""?p[i]:d "/" p[i]); print d } }' |
      sort -u | awk '{ print gsub("/","/") " " $0 }' | sort -rn | cut -d' ' -f2-)
  rmdir -- "$slot" 2>/dev/null || leftover=1
  [[ $leftover -eq 0 ]] || log warn "slot $sha has undeclared leftovers; left in place"
  return $leftover
}

cleanup_stale_incoming() { # sha : only while holding the lock, so nothing is in progress
  local sha=$1 incoming manifest
  incoming=$(stage_incoming_name "$sha") manifest=$(bundle_manifest "$sha")
  [[ -d $incoming && ! -L $incoming && -f $manifest ]] || return 0
  log warn "removing stale incoming slot for $sha (exact files only)"
  remove_slot_exact_path "$incoming" "$manifest"
}

stage_incoming_name() { printf '%s/.incoming-%s\n' "$SLOTS" "$1"; }

# Build a verified slot in RAM from the flash archive. Additive only.
materialize_slot() { # sha
  local sha=$1 slot archive manifest incoming total need have
  slot=$(slot_dir "$sha") archive=$(bundle_archive "$sha") manifest=$(bundle_manifest "$sha")
  if [[ -d $slot ]]; then
    if verify_slot "$sha"; then
      return 0
    fi
    log warn "slot $sha failed verification; removing exact files and rebuilding"
    remove_slot_exact "$sha" || { log error "corrupt slot cannot be removed exactly"; return 1; }
  fi
  verify_bundle_files "$sha" || return $EX_VERIFY
  check_host_compat "$manifest" || return $EX_VERIFY
  total=$(jq '[.files[].size]|add' "$manifest")
  need=$(( (total * 2) / 1024 + 65536 ))
  have=$(free_kb "$SLOTS")
  if [[ $have -lt $need ]]; then
    log error "insufficient RAM-disk space: need ${need}KB, have ${have}KB"
    return $EX_SPACE
  fi
  incoming=$(stage_incoming_name "$sha")
  cleanup_stale_incoming "$sha"
  if [[ -e $incoming ]]; then
    log error "stale incoming directory could not be removed exactly; inspect and remove manually"
    return 1
  fi
  mkdir -m 0755 -- "$incoming" || return 1
  if ! (umask 022; jq -r '.files[].path' "$manifest" |
        tar -xzf "$archive" -C "$incoming" --no-same-owner --no-same-permissions \
            --no-overwrite-dir --verbatim-files-from -T -) 2>/dev/null; then
    log error "extraction failed"
    remove_slot_exact_path "$incoming" "$manifest"
    return 1
  fi
  crash_point after_extract
  while IFS=' ' read -r mode path; do
    chmod "$(printf '%o' "$mode")" -- "$incoming/$path" || return 1
  done < <(jq -r '.files[] | "\(.mode) \(.path)"' "$manifest")
  printf '{"sha256":"%s","created":"%s"}\n' "$sha" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$incoming/slot.json"
  chmod 0644 -- "$incoming/slot.json"
  # The final name must be verified against flash metadata exactly like a live slot.
  if ! verify_incoming "$incoming" "$manifest"; then
    log error "extracted tree differs from manifest"
    remove_slot_exact_path "$incoming" "$manifest"
    return $EX_VERIFY
  fi
  mv -T -- "$incoming" "$slot" || return 1
  sync_path "$SLOTS"
  smoke_slot "$sha" || {
    log error "bundle binaries do not run on this host (missing library or ABI problem)"
    remove_slot_exact "$sha"
    return $EX_VERIFY
  }
}

verify_incoming() { # dir manifest
  local dir=$1 manifest=$2 expect actual
  expect=$(expected_slot_listing "$manifest")
  actual=$(find "$dir" -mindepth 1 -printf '%y %P\n' | sort -u)
  [[ "$actual" == "$expect" ]] || return 1
  (cd "$dir" && jq -r '.files[] | "\(.sha256)  \(.path)"' "$manifest" | sha256sum --check --strict --quiet) >/dev/null 2>&1
}

remove_slot_exact_path() { # dir manifest : exact cleanup of a failed incoming dir
  local dir=$1 manifest=$2 path
  [[ -d $dir && ! -L $dir ]] || return 0
  while IFS= read -r path; do
    [[ -f $dir/$path && ! -L $dir/$path ]] && rm -f -- "$dir/$path"
  done < <(jq -r '.files[].path' "$manifest")
  rm -f -- "$dir/slot.json"
  while IFS= read -r path; do
    rmdir -- "$dir/$path" 2>/dev/null || true
  done < <(jq -r '.files[].path' "$manifest" | awk '
      { n=split($0,p,"/"); d=""; for (i=1;i<n;i++) { d=(d==""?p[i]:d "/" p[i]); print d } }' |
      sort -u | awk '{ print gsub("/","/") " " $0 }' | sort -rn | cut -d' ' -f2-)
  rmdir -- "$dir" 2>/dev/null || log warn "incoming directory left in place: undeclared content"
}

run_clean() { # command... : minimal environment, bounded runtime
  env -i PATH="$SAFE_PATH" HOME="$RUN_DIR" LANG=C timeout 15 "$@"
}

smoke_slot() { # sha: new binaries must execute and report the manifest's version
  local sha=$1 slot want out rc
  slot=$(slot_dir "$sha")
  want=$(jq -r .incus_version "$(bundle_manifest "$sha")")
  for bin in incus incusd; do
    out=$(run_clean "$slot/payload/bin/$bin" --version 2>&1) || return 1
    [[ $out == *"$want"* ]] || return 1
  done
  if jq -e '.files | any(.[]; .path == "payload/tools/unsquashfs" and .mode == 493)' \
      "$(bundle_manifest "$sha")" >/dev/null 2>&1; then
    rc=0
    out=$(run_clean "$slot/payload/tools/unsquashfs" -version 2>&1) || rc=$?
    # Upstream prints its version and exits 1 when no image is named. A loader/ABI failure (127), a timeout
    # (124) or a crash (>128) is a failed probe, and so is any other first line.
    [[ ($rc == 0 || $rc == 1) && ${out%%$'\n'*} == "unsquashfs version "* ]] || return 1
  elif [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    log error "canary: bundle lacks the pinned payload/tools/unsquashfs that Incus requires"
    return 1
  fi
}

switch_current() { # sha ("" removes the link)
  local tmp="$RAM_DIR/.current.new"
  rm -f -- "$tmp"
  if [[ -z $1 ]]; then
    rm -f -- "$CURRENT"
    return 0
  fi
  ln -s -- "slots/$1" "$tmp" || return 1
  mv -T -- "$tmp" "$CURRENT"
}

current_sha_from_link() {
  local t
  t=$(readlink -- "$CURRENT" 2>/dev/null) || return 1
  t=${t#slots/}
  [[ $t =~ $SHA_RE ]] && printf '%s\n' "$t"
}

# ------------------------------------------------------------- subuid ----
SUBID_BEGIN="# BEGIN polyseat-unraid (managed block; removed on uninstall)"
SUBID_END="# END polyseat-unraid"

subid_block_line() { printf 'root:%s:%s\n' "$(cfg_get SUBID_START 1000000)" "$(cfg_get SUBID_COUNT 1000000000)"; }

subid_file_ensure() { # file
  local file=$1 line tmp start count
  line=$(subid_block_line)
  start=$(cfg_get SUBID_START 1000000) count=$(cfg_get SUBID_COUNT 1000000000)
  [[ $start =~ ^[0-9]+$ && $count =~ ^[0-9]+$ && $count -ge 65536 && $((start + count)) -le 4294967296 ]] ||
    { log error "invalid SUBID_START/SUBID_COUNT"; return 1; }
  if [[ -f $file ]] && grep -qxF -- "$SUBID_BEGIN" "$file"; then
    awk -v b="$SUBID_BEGIN" -v e="$SUBID_END" -v l="$line" '
      $0==b {inb=1; next} $0==e {inb=0; next} inb {if ($0==l) ok=1; else bad=1} END {exit (ok && !bad) ? 0 : 1}' "$file" ||
      { log error "$file: managed block was modified; refusing"; return 1; }
    return 0
  fi
  if [[ -f $file ]] && ! awk -F: -v s="$start" -v c="$count" '
      /^#/ || NF<3 {next} ($2+0) <= s+c-1 && ($2+$3-1) >= s {bad=1} END {exit bad}' "$file"; then
    log error "$file: requested ID range overlaps an existing allocation"
    return 1
  fi
  tmp=$(mktemp "$(dirname -- "$file")/.polyseat-subid-XXXXXX") || return 1
  { [[ -f $file ]] && cat -- "$file"; printf '%s\n%s\n%s\n' "$SUBID_BEGIN" "$line" "$SUBID_END"; } > "$tmp"
  chmod 0644 -- "$tmp"
  mv -T -- "$tmp" "$file"
}

subid_file_remove() { # file
  local file=$1 tmp line
  [[ -f $file ]] || return 0
  grep -qxF -- "$SUBID_BEGIN" "$file" || return 0
  line=$(subid_block_line)
  awk -v b="$SUBID_BEGIN" -v e="$SUBID_END" -v l="$line" '
    $0==b {inb=1; next} $0==e {inb=0; next} inb {if ($0!=l) bad=1} END {exit bad ? 1 : 0}' "$file" ||
    { log warn "$file: managed block modified; left untouched"; return 1; }
  tmp=$(mktemp "$(dirname -- "$file")/.polyseat-subid-XXXXXX") || return 1
  awk -v b="$SUBID_BEGIN" -v e="$SUBID_END" '$0==b {inb=1; next} $0==e {inb=0; next} !inb' "$file" > "$tmp"
  chmod 0644 -- "$tmp"
  mv -T -- "$tmp" "$file"
}

# ----------------------------------------------------------------- LSM ----
# The bundled liblxc is built without the LSM integrations listed in the manifest's
# built_without. Incus enables AppArmor only if /sys/kernel/security/apparmor exists AND
# apparmor_parser is in PATH (internal/server/sys/apparmor.go); a host that has such an LSM
# active but a liblxc that cannot use it would run containers without the confinement the
# operator expects. That is refused unless ACCEPT_NO_LSM="yes" is set explicitly.
sys_root() {
  # A sandbox probes its own fake tree unless a CI job asks for the runner's real /sys.
  if sandbox && ! ci_real_system; then printf '%s/sys\n' "$ROOT"; else printf '/sys\n'; fi
}

lsm_active() { # apparmor|selinux
  local sys
  sys=$(sys_root)
  case "$1" in
    apparmor) [[ -d $sys/kernel/security/apparmor ]] ;;
    selinux) [[ -e $sys/fs/selinux/enforce ]] ;;
    *) return 1 ;;
  esac
}

lsm_gate() { # manifest : returns 1 (and logs) if a deliberately unsupported LSM is active
  local manifest=$1 lsm blocked=0
  while IFS= read -r lsm; do
    if lsm_active "$lsm"; then
      if [[ $(cfg_get ACCEPT_NO_LSM no) == yes ]]; then
        log warn "$lsm is active on this host but the bundled liblxc has no $lsm support; ACCEPT_NO_LSM=yes: containers run WITHOUT $lsm confinement"
      else
        log error "$lsm is active on this host but the bundled liblxc has no $lsm support; refusing to start containers without it (set ACCEPT_NO_LSM=\"yes\" only after reading docs/lsm-and-security.md)"
        blocked=1
      fi
    fi
  done < <(jq -r '.built_without[]' "$manifest")
  [[ $blocked -eq 0 ]]
}

# liblxc has its rootfs mount point compiled in as an absolute path (manifest: lxc_rootfs_mount).
# It must exist or no container can start. Only that exact directory and its plugin-owned parent are created.
LXC_STATE_PARENT="/var/lib/polyseat-lxc"

lxc_mount_real() { # logical absolute path -> real path (sandbox-relative unless a CI job addresses the real system)
  if sandbox && ! ci_real_system; then printf '%s%s\n' "$ROOT" "$1"; else printf '%s\n' "$1"; fi
}

ensure_lxc_rootfs_mount() { # manifest
  local logical real parent
  logical=$(jq -r '.lxc_rootfs_mount' "$1")
  [[ $logical == "$LXC_STATE_PARENT/rootfs" ]] || { log error "unexpected lxc_rootfs_mount in manifest"; return 1; }
  real=$(lxc_mount_real "$logical") parent=$(lxc_mount_real "$LXC_STATE_PARENT")
  if [[ -L $parent || -L $real ]]; then log error "refusing a symlinked LXC state directory"; return 1; fi
  (umask 022; mkdir -p -- "$parent" && mkdir -p -- "$real") || { log error "cannot create $logical"; return 1; }
}

remove_lxc_rootfs_mount() {
  rmdir -- "$(lxc_mount_real "$LXC_STATE_PARENT/rootfs")" 2>/dev/null || true
  rmdir -- "$(lxc_mount_real "$LXC_STATE_PARENT")" 2>/dev/null || true
}

# ---------------------------------------------------------- data dir ----
DATA_REAL=""
INCUS_DIR=""

# Every ancestor must protect the name below it from untrusted replacement.
# Root-owned sticky directories (e.g. /tmp in disposable CI) protect the
# root-owned child too. Do not "fix" permissions on any shared host directory.
canary_secure_path() { # existing absolute directory (ancestors included)
  local path=$1 mode
  [[ -d $path && ! -L $path && $(realpath -e -- "$path") == "$path" ]] || return 1
  while :; do
    [[ $(stat -c %u -- "$path") == 0 ]] || return 1
    mode=$(stat -c %a -- "$path") || return 1
    (( (8#$mode & 8#022) == 0 || (8#$mode & 8#1000) != 0 )) || return 1
    [[ $path == / ]] && break
    path=$(dirname -- "$path")
  done
}

canary_validate_data_dir() { # candidate, may be absent for the first start
  local requested=$1 parent
  [[ -z $requested || $requested == "$CANARY_DATA_DIR" ]] || {
    log error "canary: only the fixed ephemeral workspace is allowed"; return 1;
  }
  DATA_REAL="$ROOT$CANARY_DATA_DIR" INCUS_DIR="$ROOT$CANARY_DATA_DIR/incus"
  parent=$(dirname -- "$DATA_REAL")
  canary_secure_path "$parent" || {
    log error "canary: workspace ancestors are not root-owned and replacement-safe"; return 1;
  }
  if [[ -e $DATA_REAL || -L $DATA_REAL ]]; then
    canary_secure_path "$DATA_REAL" || return 1
    case "$(stat -c %a -- "$DATA_REAL")" in 711 | 755) ;; *) return 1 ;; esac
  fi
  return 0
}

canary_fresh_state_prepare() {
  local active_sha=$1
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  # Never start an existing database: Incus can auto-start persisted instances
  # before an API audit is possible. Failed or completed sessions are retained
  # for inspection, not silently deleted or re-used by start/restart/recover.
  [[ ! -e $INCUS_DIR && ! -L $INCUS_DIR && ! -e $CANARY_SESSION && ! -L $CANARY_SESSION ]] || {
    log error "canary: prior state/session exists; inspection required, no restart"; return 1;
  }
  if [[ -d $DATA_REAL ]]; then
    [[ -z $(find "$DATA_REAL" -mindepth 1 -maxdepth 1 -print -quit) ]] || {
      log error "canary: workspace is not empty; refusing all persisted state"; return 1;
    }
  else
    (umask 022; mkdir -- "$DATA_REAL") || return 1
  fi
  (umask 022; mkdir -- "$INCUS_DIR") || return 1
  # Kept after stop/uninstall: intentional evidence of a one-shot run.
  write_json_atomic "$DATA_REAL/one-shot.json" \
    "$(jq -n --arg sha "$active_sha" '{schema:1,archive_sha256:$sha,kind:"ephemeral-cpu-only"}')"
}

validate_data_dir() { # [candidate logical path]
  local d anc mode
  d=${1:-$(cfg_get DATA_DIR "")}
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    canary_validate_data_dir "$d"; return
  fi
  [[ -n $d ]] || { log error "DATA_DIR is not configured (select a pool path first)"; return 1; }
  [[ $d =~ ^/mnt/[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$ ]] || { log error "DATA_DIR must be an absolute path below /mnt"; return 1; }
  case "$d" in
    /mnt/user | /mnt/user/* | /mnt/user0 | /mnt/user0/* | /mnt/disks | /mnt/remotes/* | /mnt/addons/*)
      log error "DATA_DIR must be on a real pool or disk, not a FUSE/user share"; return 1 ;;
  esac
  [[ $d != *..* ]] || { log error "DATA_DIR contains '..'"; return 1; }
  DATA_REAL="$ROOT$d"
  [[ -d $DATA_REAL && ! -L $DATA_REAL ]] || { log error "DATA_DIR does not exist or is a symlink"; return 1; }
  [[ "$(realpath -e -- "$DATA_REAL")" == "$(realpath -m -- "$DATA_REAL")" ]] || { log error "DATA_DIR resolves through a symlink"; return 1; }
  case "$(fs_type "$DATA_REAL")" in
    zfs | xfs | btrfs | ext2/ext3 | ext4) ;;
    tmpfs | overlay | overlayfs)
      sandbox || { log error "unsupported DATA_DIR filesystem: $(fs_type "$DATA_REAL")"; return 1; } ;;
    *) log error "unsupported DATA_DIR filesystem: $(fs_type "$DATA_REAL")"; return 1 ;;
  esac
  anc=$DATA_REAL
  while [[ $anc != "/" && $anc != "$ROOT" && -n $anc ]]; do
    mode=$(stat -c %a -- "$anc")
    (( (8#$mode & 8#001) != 0 )) || { log error "$anc is not traversable by guest UIDs (needs o+x); not changing user directories"; return 1; }
    anc=$(dirname -- "$anc")
  done
  INCUS_DIR="$DATA_REAL/incus"
}

# ------------------------------------------------------------ service ----
# Same lookup the daemon performs at start, with the PATH it will get (bundled helpers first). Runs before any
# canary state exists, so a host that lacks a program fails closed without leaving a retry-blocking workspace.
daemon_programs_check() { # resolved slot
  local slot_real=$1 program missing=""
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    # Never fall back to a host squashfs-tools: Unraid has none and only the signed bundle was reviewed.
    [[ -f $slot_real/payload/tools/unsquashfs && ! -L $slot_real/payload/tools/unsquashfs &&
       -x $slot_real/payload/tools/unsquashfs ]] || { log error "canary: bundled unsquashfs missing"; return 1; }
  fi
  for program in $INCUSD_REQUIRED_PROGRAMS; do
    ( PATH="$slot_real/payload/tools:$SAFE_PATH"; hash -r; command -v "$program" >/dev/null 2>&1 ) ||
      missing+=" $program"
  done
  [[ -z $missing ]] || { log error "required daemon programs missing on PATH:$missing"; return 1; }
}

svc_pid() {
  local pid cmd
  [[ -f $PIDFILE && ! -L $PIDFILE ]] || return 1
  pid=$(cat -- "$PIDFILE")
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
  [[ $cmd == *"$SLOTS/"*"/payload/bin/incusd"* ]] || return 1
  printf '%s\n' "$pid"
}

run_incus() { # args...
  local limit=${INCUS_CMD_TIMEOUT:-20} remaining
  # Never fall back to Incus' default state directory: it could belong to someone else.
  [[ -n $INCUS_DIR && $INCUS_DIR == "$DATA_REAL/incus" ]] || { log error "refusing to run incus without a validated INCUS_DIR"; return 1; }
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    canary_command_allowed "$@" || { log error "canary: Incus command outside the fixed CPU-only path"; return 1; }
    canary_watchdog_check || { log error "canary: expiry supervisor is not healthy"; return 1; }
    if [[ $CANARY_HEALTH_DEADLINE -gt 0 ]]; then
      remaining=$((CANARY_HEALTH_DEADLINE - $(canary_monotonic_seconds)))
      [[ $remaining -gt 0 ]] || return 1
      [[ $limit -le $remaining ]] || limit=$remaining
    fi
  fi
  env -i PATH="$SAFE_PATH" HOME="$RUN_DIR" LANG=C INCUS_DIR="$INCUS_DIR" INCUS_CONF="$RUN_DIR/client" \
    timeout "$limit" "$CURRENT/payload/bin/incus" "$@"
}

canary_command_allowed() {
  # Defense against accidental controller expansion, NOT a sandbox against
  # trusted host root opening the Incus socket or executing a binary directly.
  case "$*" in
    'info' | 'config get core.https_address' | 'query /1.0' | \
    'query /1.0/projects?recursion=1' | 'query /1.0/profiles?recursion=1' | \
    'query /1.0/instances?recursion=1' | 'query /1.0/storage-pools?recursion=1' | \
    'query /1.0/networks?recursion=1' | 'query /1.0/instances/polyseat-canary-cpu/state') return 0 ;;
  esac
  [[ $CANARY_OPERATION -eq 1 ]] || return 1
  case "$*" in
    "storage create default dir source=$INCUS_DIR/storage-pools/default" | \
    'profile device add default root disk path=/ pool=default' | \
    "image import $CURRENT/payload/share/canary/busybox.tar.gz --alias polyseat-canary-busybox" | \
    'init polyseat-canary-busybox polyseat-canary-cpu --storage default --config boot.autostart=false --config security.privileged=false --config security.nesting=false' | \
    'start polyseat-canary-cpu' | \
    'exec polyseat-canary-cpu -- /bin/busybox echo POLYSEAT_CANARY_OK' | \
    'stop polyseat-canary-cpu --force --timeout 5' | 'delete polyseat-canary-cpu' | \
    'image delete polyseat-canary-busybox') return 0 ;;
    *) return 1 ;;
  esac
}

# A canary package is NOT built by the regular package job. Even if a future,
# separately approved renderer enables it, fail closed until all safeguards
# are valid. Never enable controllers or change shared cgroups here.
canary_cgroup_precheck() { # read-only: before any canary state exists, and again right before the groups
  local controller available enabled parent_cpus parent_mems
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  [[ -z $(cfg_get DATA_DIR '') || $(cfg_get DATA_DIR '') == "$CANARY_DATA_DIR" ]] || {
    log error "canary: DATA_DIR must be dedicated to this CPU-only test"; return 1;
  }
  [[ $(fs_type /sys/fs/cgroup) == cgroup2fs && ! -L $CANARY_CGROUP && ! -L $CANARY_WATCHDOG_CGROUP ]] || {
    log error "canary: unified cgroup v2 required"; return 1;
  }
  [[ ! -e $CANARY_CGROUP && ! -e $CANARY_WATCHDOG_CGROUP ]] || {
    log error "canary: stale/existing cgroup requires manual inspection"; return 1;
  }
  available=" $(< /sys/fs/cgroup/cgroup.controllers) "
  enabled=" $(< /sys/fs/cgroup/cgroup.subtree_control) "
  for controller in cpu cpuset memory pids; do
    [[ $available == *" $controller "* && $enabled == *" $controller "* ]] || {
      log error "canary: $controller is not already delegated at cgroup root"; return 1;
    }
  done
  parent_cpus=$(< /sys/fs/cgroup/cpuset.cpus.effective)
  parent_mems=$(< /sys/fs/cgroup/cpuset.mems.effective)
  [[ $parent_cpus == "$CANARY_HOST_CPUSET" && $parent_mems =~ ^[0-9]+([,-][0-9]+)*$ ]] || {
    log error "canary: unexpected CPU or NUMA topology: refusing fixed E-core assignment"; return 1;
  }
}

canary_cgroup_prepare() {
  local parent_mems
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  canary_cgroup_precheck || return 1
  parent_mems=$(< /sys/fs/cgroup/cpuset.mems.effective)
  [[ $parent_mems =~ ^[0-9]+([,-][0-9]+)*$ ]] || return 1
  mkdir -- "$CANARY_CGROUP" || return 1
  if ! mkdir -- "$CANARY_WATCHDOG_CGROUP"; then rmdir -- "$CANARY_CGROUP"; return 1; fi
  if ! {
    printf '%s\n' "$parent_mems" > "$CANARY_CGROUP/cpuset.mems" &&
    printf '%s\n' "$CANARY_CPUSET" > "$CANARY_CGROUP/cpuset.cpus" &&
    printf '%s\n' "$parent_mems" > "$CANARY_WATCHDOG_CGROUP/cpuset.mems" &&
    printf '%s\n' "$CANARY_CPUSET" > "$CANARY_WATCHDOG_CGROUP/cpuset.cpus" &&
    printf '%s\n' "$CANARY_CPU_MAX" > "$CANARY_CGROUP/cpu.max" &&
    printf '%s\n' "$CANARY_MEMORY_MAX" > "$CANARY_CGROUP/memory.max" &&
    printf '1\n' > "$CANARY_CGROUP/memory.oom.group" &&
    printf '0\n' > "$CANARY_CGROUP/memory.swap.max" &&
    printf '%s\n' "$CANARY_PIDS_MAX" > "$CANARY_CGROUP/pids.max" &&
    printf '50000 1000000\n' > "$CANARY_WATCHDOG_CGROUP/cpu.max" &&
    printf '%s\n' "$CANARY_WATCHDOG_MEMORY_MAX" > "$CANARY_WATCHDOG_CGROUP/memory.max" &&
    printf '0\n' > "$CANARY_WATCHDOG_CGROUP/memory.swap.max" &&
    printf '16\n' > "$CANARY_WATCHDOG_CGROUP/pids.max" &&
    mkdir -- "$CANARY_CGROUP/daemon";
  }; then
    rmdir -- "$CANARY_CGROUP/daemon" 2>/dev/null || true
    rmdir -- "$CANARY_CGROUP" 2>/dev/null || true
    rmdir -- "$CANARY_WATCHDOG_CGROUP" 2>/dev/null || true
    log error "canary: cgroup limits could not be set; daemon not launched"
    return 1
  fi
  if ! canary_cgroup_check; then
    rmdir -- "$CANARY_CGROUP/daemon" "$CANARY_CGROUP" "$CANARY_WATCHDOG_CGROUP" 2>/dev/null || true
    return 1
  fi
}

canary_cgroup_check() {
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  [[ -d $CANARY_CGROUP && ! -L $CANARY_CGROUP ]] || return 1
  [[ $(< "$CANARY_CGROUP/cpuset.cpus") == "$CANARY_CPUSET" &&
     $(< "$CANARY_CGROUP/cpu.max") == "$CANARY_CPU_MAX" &&
     $(< "$CANARY_CGROUP/memory.max") == "$CANARY_MEMORY_MAX" &&
     $(< "$CANARY_CGROUP/memory.oom.group") == 1 &&
     $(< "$CANARY_CGROUP/memory.swap.max") == 0 &&
     $(< "$CANARY_CGROUP/pids.max") == "$CANARY_PIDS_MAX" &&
     -d $CANARY_WATCHDOG_CGROUP && ! -L $CANARY_WATCHDOG_CGROUP &&
     $(< "$CANARY_WATCHDOG_CGROUP/cpuset.cpus") == "$CANARY_CPUSET" &&
     $(< "$CANARY_WATCHDOG_CGROUP/cpu.max") == "50000 1000000" &&
     $(< "$CANARY_WATCHDOG_CGROUP/memory.max") == "$CANARY_WATCHDOG_MEMORY_MAX" &&
     $(< "$CANARY_WATCHDOG_CGROUP/memory.swap.max") == 0 &&
     $(< "$CANARY_WATCHDOG_CGROUP/pids.max") == 16 ]]
}

canary_cgroup_remove() { # one exact plugin-owned cgroup and its descendants
  local group=$1 i child
  [[ $group == "$CANARY_CGROUP" || $group == "$CANARY_WATCHDOG_CGROUP" ]] || return 1
  [[ ! -e $group ]] && return 0
  [[ -d $group && ! -L $group && $(fs_type "$group") == cgroup2fs ]] || return 1
  printf '1\n' > "$group/cgroup.kill" || [[ ! -e $group ]] || return 1
  for ((i = 0; i < 50; i++)); do
    # Unraid's cgroup2-unraid daemon rmdirs empty top-level groups by itself. The kernel removes a cgroup
    # only without tasks and children, so a vanished group is a completed removal, not a hidden leak;
    # canary_leak_check still looks for any surviving canary process afterwards.
    [[ -e $group ]] || return 0
    # cgroupfs cannot contain symlinks or user files. Remove empty *directories*
    # only, below this owned boundary; never recursively delete data files.
    while IFS= read -r -d '' child; do rmdir -- "$child" 2>/dev/null || true; done \
      < <(find "$group" -xdev -depth -mindepth 1 -type d -print0 2>/dev/null)
    rmdir -- "$group" 2>/dev/null && return 0
    sleep 0.1
  done
  [[ ! -e $group ]]
}

# After both groups are gone no canary code may run anywhere: neither a bundled binary (incusd, its forks,
# the incus CLI) nor the supervisor/witness/launcher shells, which are recognised by their exact argv0.
canary_leak_check() {
  local proc pid exe found="" element
  local -a argv
  [[ $SLOTS == /*/slots ]] || { log error "canary: leak check without a valid slot root"; return 1; }
  for proc in /proc/[0-9]*; do
    pid=${proc#/proc/}
    [[ $pid == "$$" || $pid == "$BASHPID" ]] && continue
    exe=$(readlink -- "$proc/exe" 2>/dev/null) || exe=""
    exe=${exe% (deleted)}
    if [[ -n $exe && $exe == "$SLOTS"/* ]]; then found+=" $pid"; continue; fi
    mapfile -d '' -t argv < "$proc/cmdline" 2>/dev/null || continue
    for element in "${argv[@]}"; do
      case "$element" in
        canary-watchdog | canary-guardian | polyseat-canary-launch) found+=" $pid"; break ;;
      esac
    done
  done
  [[ -z $found ]] || { log error "canary: processes survived cgroup removal:$found"; return 1; }
}

canary_cgroup_stop() {
  local rc=0
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  # Stop work BEFORE its supervisor. No Incus API, token, PID file, or healthy
  # database is needed for this emergency path, including after token expiry.
  canary_cgroup_remove "$CANARY_CGROUP" || rc=1
  [[ $rc -ne 0 ]] || canary_cgroup_remove "$CANARY_WATCHDOG_CGROUP" || rc=1
  [[ $rc -ne 0 ]] || canary_leak_check || rc=1
  [[ $rc -eq 0 ]] || log error "canary: owned cgroup could not be emptied and removed"
  return "$rc"
}

canary_monotonic_seconds() {
  local uptime _unused
  read -r uptime _unused < /proc/uptime || return 1
  printf '%s\n' "${uptime%%.*}"
}

canary_process_starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }

canary_budget_check() {
  local kb bytes=0 file size
  # du exits non-zero when an entry vanishes mid-walk (Incus removes files during
  # stop/delete) but still prints the total; only a missing/non-numeric total fails.
  kb=$( { du -skx -- "$DATA_REAL" 2>/dev/null || true; } | awk 'NR == 1 {print $1}')
  [[ $kb =~ ^[0-9]+$ && $kb -le $CANARY_DATA_MAX_KB ]] || return 1
  for file in "$LOG_DIR/incusd.log" "$LOG_DIR/incusd.out" "$LOG_DIR/$PLUGIN.log" "$LOG_DIR/$PLUGIN.log.1"; do
    [[ ! -e $file && ! -L $file ]] && continue
    [[ -f $file && ! -L $file && $(stat -c %u -- "$file") == 0 ]] || return 1
    size=$(stat -c %s -- "$file") || return 1
    bytes=$((bytes + size))
  done
  [[ $bytes -le $CANARY_LOG_MAX_BYTES ]]
}

canary_host_pressure_check() {
  awk -v minimum="$CANARY_HOST_MIN_AVAILABLE_KB" \
    '$1 == "MemAvailable:" { ok = ($2 >= minimum) } END { exit !ok }' /proc/meminfo &&
    awk -v maximum="$CANARY_HOST_MAX_LOAD" '{ exit !($1 <= maximum) }' /proc/loadavg
}

canary_watchdog_loop() { # epoch deadline, monotonic deadline
  local expiry=$1 deadline=$2 pid=$BASHPID started aborted=0
  printf '%s\n' "$pid" > "$CANARY_WATCHDOG_CGROUP/cgroup.procs" || return 1
  renice -n 19 -p "$pid" >/dev/null || return 1
  trap 'printf "1\n" > "$CANARY_CGROUP/cgroup.kill" 2>/dev/null || true' EXIT
  trap 'exit 1' TERM HUP INT
  started=$(canary_process_starttime "$pid") || return 1
  write_json_atomic "$CANARY_SESSION" "$(jq -n --argjson p "$pid" --arg s "$started" \
    --argjson e "$expiry" --argjson d "$deadline" \
    '{schema:1,pid:$p,starttime:$s,expires_at:$e,deadline_monotonic:$d}')" || return 1
  # This supervisor has its own small cgroup and survives a workload OOM.
  # It is not a security boundary against host root; host root is trusted.
  # SIGTERM/HUP/session closure still tears down the bounded workload first.
  while [[ -d $CANARY_CGROUP ]]; do
    if (( $(date -u +%s) >= expiry || $(canary_monotonic_seconds) >= deadline )); then
      [[ $aborted -ne 0 ]] || log error "canary: signed window expired; hard-stopping workload"
      [[ $aborted -ne 0 ]] || printf 'expired\n' > "$CANARY_SESSION.reason"
      aborted=1
    fi
    if [[ $aborted -eq 0 ]] && { ! canary_cgroup_check || ! canary_budget_check || ! canary_host_pressure_check; }; then
      log error "canary: resource policy/budget changed; hard-stopping workload"
      printf 'resource-policy-or-budget\n' > "$CANARY_SESSION.reason"
      aborted=1
    fi
    if [[ $aborted -eq 1 ]]; then
      # Keep reaping until explicit cleanup removes the tree. This also
      # catches a launcher crossing the exact expiry instant, or lost SSH.
      printf '1\n' > "$CANARY_CGROUP/cgroup.kill" || return 1
      sleep 0.1
      continue
    fi
    sleep 1
  done
}

canary_watchdog_start() {
  local expiry now remaining mono pid i
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  expiry=$(jq -er '.expires_at' "$CANARY_APPROVAL") || return 1
  now=$(date -u +%s) mono=$(canary_monotonic_seconds) || return 1
  remaining=$((expiry - now))
  [[ $remaining -gt 0 && $remaining -le 1800 ]] || return 1
  # setsid via a function-exported bash keeps the supervisor independent of
  # SSH/interactive sessions. No child inherits controller lock descriptor 9.
  # shellcheck disable=SC2016  # arguments expand only in the child Bash
  env -i PATH="$SAFE_PATH" POLYSEAT_RELEASE_GATE="$POLYSEAT_RELEASE_GATE" \
    ROOT="$ROOT" LOG_ENABLED=0 PLUGIN="$PLUGIN" LOG_DIR="$LOG_DIR" DATA_REAL="$DATA_REAL" \
    CANARY_CGROUP="$CANARY_CGROUP" CANARY_WATCHDOG_CGROUP="$CANARY_WATCHDOG_CGROUP" \
    CANARY_SESSION="$CANARY_SESSION" CANARY_CPUSET="$CANARY_CPUSET" CANARY_CPU_MAX="$CANARY_CPU_MAX" \
    CANARY_MEMORY_MAX="$CANARY_MEMORY_MAX" CANARY_PIDS_MAX="$CANARY_PIDS_MAX" \
    CANARY_WATCHDOG_MEMORY_MAX="$CANARY_WATCHDOG_MEMORY_MAX" \
    CANARY_DATA_MAX_KB="$CANARY_DATA_MAX_KB" CANARY_LOG_MAX_BYTES="$CANARY_LOG_MAX_BYTES" \
    CANARY_HOST_MIN_AVAILABLE_KB="$CANARY_HOST_MIN_AVAILABLE_KB" CANARY_HOST_MAX_LOAD="$CANARY_HOST_MAX_LOAD" \
    setsid bash -u -o pipefail -c "$(declare -f canary_watchdog_loop canary_process_starttime write_json_atomic sync_path \
      canary_monotonic_seconds canary_cgroup_check canary_budget_check canary_host_pressure_check log sandbox)"$'\n''canary_watchdog_loop "$@"' \
    canary-watchdog "$expiry" "$((mono + remaining))" \
    >/dev/null 2>&1 </dev/null 9>&- &
  pid=$!
  for ((i = 0; i < 50; i++)); do
    [[ -f $CANARY_SESSION && ! -L $CANARY_SESSION ]] && canary_watchdog_check && return 0
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  log error "canary: independent expiry supervisor did not become ready"
  return 1
}

canary_watchdog_check() {
  local pid started expiry deadline
  [[ ! -e $CANARY_SESSION.reason && ! -L $CANARY_SESSION.reason ]] || return 1
  check_private_file "$CANARY_SESSION" || return 1
  read -r pid started expiry deadline < <(jq -er \
    '[.pid,.starttime,.expires_at,.deadline_monotonic] | @tsv' "$CANARY_SESSION") || return 1
  [[ $pid =~ ^[0-9]+$ && $started =~ ^[0-9]+$ && $expiry =~ ^[0-9]+$ && $deadline =~ ^[0-9]+$ ]] || return 1
  [[ $(canary_process_starttime "$pid") == "$started" && \
     $(< "/proc/$pid/cgroup") == "0::/${CANARY_WATCHDOG_CGROUP##*/}" ]] || return 1
  (( $(date -u +%s) < expiry && $(canary_monotonic_seconds) < deadline ))
}

canary_guardian_start() {
  local pid started expiry deadline guardian i
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  canary_watchdog_check || return 1
  read -r pid started expiry deadline < <(jq -er \
    '[.pid,.starttime,.expires_at,.deadline_monotonic] | @tsv' "$CANARY_SESSION") || return 1
  # This tiny witness shares the WORKLOAD OOM group, not the supervisor group.
  # If the external supervisor disappears (including SIGKILL/OOM), it kills
  # its own entire workload tree. If the witness itself OOMs, oom.group=1 does
  # the same. Thus a watchdog-cgroup OOM cannot silently remove the TTL limit.
  # shellcheck disable=SC2016  # positional parameters expand in the witness
  env -i PATH="$SAFE_PATH" setsid bash -u -o pipefail -c '
    group=$1 ready=$2 supervisor=$3 expected=$4 expiry=$5 deadline=$6 me=$BASHPID
    printf "%s\n" "$me" > "$group/daemon/cgroup.procs" || exit 1
    mine=$(awk "{print \$22}" "/proc/$me/stat") || exit 1
    printf "%s %s\n" "$me" "$mine" > "$ready" || exit 1
    trap '\''printf "1\n" > "$group/cgroup.kill" 2>/dev/null || true'\'' EXIT
    trap '\''exit 1'\'' HUP INT TERM
    while [[ -d $group ]]; do
      actual=$(awk "{print \$22}" "/proc/$supervisor/stat" 2>/dev/null) || exit 1
      read -r uptime unused < /proc/uptime || exit 1
      [[ $actual == "$expected" ]] || exit 1
      (( ${uptime%%.*} < deadline && $(date -u +%s) < expiry )) || exit 1
      sleep 1
    done
  ' canary-guardian "$CANARY_CGROUP" "$RUN_DIR/canary-guardian.pid" "$pid" "$started" "$expiry" "$deadline" \
    >/dev/null 2>&1 </dev/null 9>&- &
  guardian=$!
  for ((i = 0; i < 30; i++)); do
    canary_guardian_check && return 0
    kill -0 "$guardian" 2>/dev/null || break
    sleep 0.1
  done
  return 1
}

canary_guardian_check() {
  local pid started
  check_private_file "$RUN_DIR/canary-guardian.pid" || return 1
  read -r pid started < "$RUN_DIR/canary-guardian.pid" || return 1
  [[ $pid =~ ^[0-9]+$ && $started =~ ^[0-9]+$ && $(canary_process_starttime "$pid") == "$started" && \
    $(< "/proc/$pid/cgroup") == "0::/${CANARY_CGROUP##*/}/daemon" ]]
}

# Module tools, plus the host storage/virtualisation tools that Incus only probes for other storage or VM
# drivers (btrfs/lvm "version", zfs/zpool, qemu). The CPU-only canary uses the dir driver alone, so its daemon
# must not run Tower's own LVM, btrfs, ZFS or QEMU binaries at all (Tower has them; the CI runner does not).
CANARY_DENIED_TOOLS="modprobe insmod rmmod btrfs lvm zfs zpool qemu-system-x86_64"

canary_deny_tools_prepare() {
  local tool dir="$RUN_DIR/deny-tools"
  [[ ! -e $dir && ! -L $dir ]] || return 1
  mkdir -m 0700 -- "$dir" || return 1
  for tool in $CANARY_DENIED_TOOLS; do
    # Fixed, root-private commands in OUR PATH. Never touch host /sbin tools.
    # CAP_SYS_MODULE alone would not block modprobe configuration install hooks.
    printf '%s\n' '#!/bin/sh' \
      'printf "%s\n" "canary: host module, storage and VM tools are disabled" >&2' 'exit 126' > "$dir/$tool" || return 1
    chmod 0700 -- "$dir/$tool" || return 1
  done
}

# Incus is only allowed to operate one isolated, unprivileged disk-only
# container. Audit *all* profiles and instances, including expanded devices;
# unknown JSON shape, extra projects/config or query failure always blocks.
canary_profile_guard() {
  local server projects profiles instances pools networks
  [[ $POLYSEAT_RELEASE_GATE == canary ]] || return 0
  # The profiles and instances endpoints operate in the default project only.
  # Any additional project would bypass the checks below, so forbid it first.
  server=$(INCUS_CMD_TIMEOUT=5 run_incus query /1.0) || return 1
  projects=$(INCUS_CMD_TIMEOUT=10 run_incus query '/1.0/projects?recursion=1') || return 1
  profiles=$(INCUS_CMD_TIMEOUT=10 run_incus query '/1.0/profiles?recursion=1') || return 1
  instances=$(INCUS_CMD_TIMEOUT=10 run_incus query '/1.0/instances?recursion=1') || return 1
  pools=$(INCUS_CMD_TIMEOUT=10 run_incus query '/1.0/storage-pools?recursion=1') || return 1
  networks=$(INCUS_CMD_TIMEOUT=5 run_incus query '/1.0/networks?recursion=1') || return 1
  jq -en --argjson server "$server" --argjson projects "$projects" --argjson profiles "$profiles" \
    --argjson instances "$instances" --argjson pools "$pools" --argjson networks "$networks" \
    --arg source "$INCUS_DIR/storage-pools/default" '
    def object: if type == "object" and .type == "sync" and .status_code == 200
      then .metadata else . end | if type == "object" then . else error("unexpected API object") end;
    def records: if type == "array" then . elif .type == "sync" and .status_code == 200
      and (.metadata|type) == "array" then .metadata else error("unexpected API data") end;
    def root_only: type == "object" and (to_entries | all(.[];
      .key == "root" and .value == {type:"disk", path:"/", pool:"default"}));
    def safe_cfg: type == "object" and (to_entries | all(.[];
      (.key | startswith("image.")) and (.value|type == "string") or
      (.key as $k | ["volatile.base_image", "volatile.idmap.base", "volatile.idmap.current",
        "volatile.idmap.next", "volatile.last_state.idmap", "volatile.last_state.power",
        "volatile.last_state.ready", "volatile.uuid", "volatile.uuid.generation",
        "volatile.apply_template", "volatile.cloud-init.instance-id"] | index($k) != null)
        and (.value|type == "string") or
      (.key == "boot.autostart" or .key == "security.privileged" or .key == "security.nesting")
        and .value == "false"));
    def project_cfg: type == "object" and (to_entries | all(.[];
      (.key as $k | ["features.images", "features.networks", "features.networks.zones",
        "features.profiles", "features.storage.buckets", "features.storage.volumes"] | index($k) != null)
      and .value == "true"));
    ($server | object) as $srv |
    ($projects | records) as $pr | ($profiles | records) as $ps |
    ($instances | records) as $is | ($pools | records) as $sp |
    ($srv.config | type == "object" and length == 0) and
    (($srv.environment.server_clustered // false) == false) and
    ($networks | records | all(.[]; .managed == false)) and
    ($pr | length == 1 and .[0].name == "default" and (.[0].config // {} | project_cfg)) and
    ($ps | length == 1 and .[0].name == "default" and (.[0].config // {} | type == "object" and length == 0)
      and (.[0].devices // {} | root_only)) and
    ($sp | length <= 1 and all(.[]; .name == "default" and .driver == "dir" and
      (.config | type == "object" and .source == $source and
        (to_entries|all(.[]; (.key == "source" or .key == "volatile.initial_source") and .value == $source))))) and
    ($is | length <= 1 and all(.[];
      .type == "container" and .name == "polyseat-canary-cpu" and
      (.profiles == ["default"]) and
      (.config // {} | safe_cfg) and
      (.expanded_config // {} | safe_cfg) and
      (.devices // {} | root_only) and
      (.expanded_devices // {} | root_only)))' >/dev/null || {
    log error "canary: Incus policy violation (server, project, profile, instance, storage, network or device)"; return 1;
  }
}

health_check() {
  local pid addr
  pid=$(svc_pid) || { log error "health: daemon process not running"; return 1; }
  [[ -S $INCUS_DIR/unix.socket ]] || { log error "health: management socket missing"; return 1; }
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    [[ ! -L $INCUS_DIR/unix.socket && $(stat -c '%u %a' -- "$INCUS_DIR/unix.socket") == '0 600' ]] || return 1
    canary_watchdog_check || { log error "health: expiry supervisor missing or expired"; return 1; }
    canary_guardian_check || { log error "health: supervisor witness missing"; return 1; }
  fi
  run_incus info >/dev/null 2>&1 || { log error "health: 'incus info' failed"; return 1; }
  addr=$(run_incus config get core.https_address 2>/dev/null) || { log error "health: cannot read listener config"; return 1; }
  [[ -z $addr ]] || { log error "health: unexpected network listener configured: $addr"; return 1; }
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    canary_cgroup_check || { log error "health: canary cgroup limits invalid"; return 1; }
    [[ $(< "/proc/$pid/cgroup") == "0::/${CANARY_CGROUP##*/}/daemon" ]] || {
      log error "health: daemon escaped dedicated cgroup"; return 1;
    }
    canary_profile_guard || return 1
  fi
  log debug "health ok (pid $pid)"
}

canary_launch() { # resolved slot; called in the disposable launch subshell
  local slot_real=$1 parent_mnt_ns
  parent_mnt_ns=$(readlink /proc/self/ns/mnt) || return 1
  [[ $parent_mnt_ns =~ ^mnt:\[[0-9]+\]$ ]] || return 1
  [[ ! -e $RUN_DIR/canary-emergency-stop ]] && canary_watchdog_check || return 1
  renice -n 19 -p "$BASHPID" >/dev/null || return 1
  printf '%s\n' "$BASHPID" > "$CANARY_CGROUP/daemon/cgroup.procs" || return 1
  # The OUTER parent has the hard aggregate limits. Do NOT enable controllers
  # in its subtree: this daemon leaf then advertises no controllers to LXC.
  # LXC supports that mode, and monitor/payload descendants still inherit all
  # outer limits. This avoids cgroup-v2's no-internal-processes rule.
  # LXC normally reads /proc/1/cgroup for root containers. Both a private PID
  # namespace and a private proc mount are essential to keep that root local.
  # Drop explicit kernel-module/raw-I/O privileges for the entire process tree.
  # shellcheck disable=SC2016  # launcher body must expand in its new namespaces
  exec setsid env -i PATH="$RUN_DIR/deny-tools:$slot_real/payload/tools:$SAFE_PATH" HOME="$RUN_DIR" LANG=C INCUS_DIR="$INCUS_DIR" \
    INCUS_CONF="$RUN_DIR/client" INCUS_EXEC_PATH="$slot_real/payload/bin/incusd" \
    INCUS_LXC_HOOK="$slot_real/payload/share/lxc/hooks" INCUS_SKIP_INSTANCE_TYPES=true INCUS_SECURITY_APPARMOR=false \
    setpriv --bounding-set=-sys_module,-sys_rawio \
    unshare --mount --cgroup --pid --fork --kill-child=KILL --propagation private \
    bash -u -o pipefail -c '
      # /proc is still the outer proc mount here, so its self/stat yields the
      # HOST pid even though $$ is already 1 in the new PID namespace.
      read -r host_pid unused < /proc/self/stat || exit 1
      [[ $host_pid =~ ^[0-9]+$ && $$ == 1 ]] || exit 1
      printf "%s\n" "$host_pid" > "$1" || exit 1
      # BEGIN_PRIVATE_CGROUP_REBASE: inherited cgroup2 mounts retain their old
      # root and cannot be overmounted with the same superblock (EBUSY).
      private_mount_failure() {
        printf "canary private mount failure: %s\n" "$1" >&2
        for ns in mnt cgroup pid; do
          printf "%s " "$ns" >&2
          readlink "/proc/self/ns/$ns" >&2 || true
        done
        awk '\''$5 == "/proc" || $5 == "/sys/fs/cgroup" { print }'\'' /proc/self/mountinfo >&2
        exit 1
      }
      private_cgroup_mount() {
        # Check ALL inherited mounts: a shared /sys parent could propagate a
        # fresh mount even if the previous cgroup target itself was private.
        awk -v expected_root="${1:-}" '\''
          { for (i=7; i<=NF && $i != "-"; i++)
              if ($i ~ /^(shared|master|propagate_from):/) bad=1 }
          $5 == "/sys/fs/cgroup" {
            count++
            if ($0 !~ / - cgroup2 / || (expected_root != "" && $4 != expected_root)) bad=1
          }
          END { exit (count != 1 || bad) }
        '\'' /proc/self/mountinfo
      }
      child_mnt_ns=$(readlink /proc/self/ns/mnt) || private_mount_failure namespace
      [[ $child_mnt_ns =~ ^mnt:\[[0-9]+\]$ && $child_mnt_ns != "$2" ]] || private_mount_failure namespace
      private_cgroup_mount || private_mount_failure propagation
      mount -n -t proc -o nosuid,nodev,noexec proc /proc || private_mount_failure proc
      umount -n /sys/fs/cgroup || private_mount_failure unmount-cgroup
      mount -n -t cgroup2 -o nosuid,nodev,noexec none /sys/fs/cgroup || private_mount_failure cgroup
      private_cgroup_mount / || private_mount_failure cgroup-root
      # END_PRIVATE_CGROUP_REBASE
      [[ $(< /proc/1/cgroup) == "0::/" && -z $(< /sys/fs/cgroup/cgroup.controllers) ]] || private_mount_failure cgroup-view
      shift 2
      exec "$@"
    ' polyseat-canary-launch "$PIDFILE" "$parent_mnt_ns" "$slot_real/payload/bin/incusd" \
      --group "" --logfile "$LOG_DIR/incusd.log" 9>&-
}

# An incusd that is not ours. Helper processes of running containers (forklxc, forkexec, ...) carry the
# same name but execute our own binary, so they are recognised by their executable path, not by name.
foreign_incusd() {
  local pid exe out=""
  for pid in $(pgrep -x incusd || true); do
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
    exe=${exe% (deleted)}
    [[ $exe == "$SLOTS"/*/payload/bin/incusd ]] && continue
    out+="$pid "
  done
  printf '%s\n' "${out% }"
}

svc_start() {
  local timeout i foreign slot_real active_sha deadline tool
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    require_approval start
    if [[ $CANARY_OPERATION -eq 1 ]]; then canary_approval_for canary-smoke; else canary_approval_for start; fi
    canary_host_pressure_check || { log error "canary: host memory/load outside approved safety window"; return 1; }
  fi
  [[ -L $CURRENT ]] || { log error "no active bundle"; return 1; }
  slot_real=$(readlink -f -- "$CURRENT") || return 1
  active_sha=$(current_sha_from_link) || { log error "active bundle link is not a slot"; return 1; }
  lsm_gate "$(bundle_manifest "$active_sha")" || return 1
  # Stub-daemon sandboxes have no real incusd; real hosts and the real CI system always check, before any write.
  if ! sandbox || ci_real_system; then daemon_programs_check "$slot_real" || return 1; fi
  ensure_lxc_rootfs_mount "$(bundle_manifest "$active_sha")" || return 1
  validate_data_dir || return 1
  if svc_pid >/dev/null; then
    if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
      health_check || return 1
      CANARY_RUN_OWNED=1
    fi
    log info "service already running"
    return 0
  fi
  foreign=$(foreign_incusd)
  [[ -z $foreign ]] || { log error "another incusd process exists (pid ${foreign// /,}); refusing to start"; return 1; }
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    # One name per lookup: `command -v a b` succeeds if any one of them exists.
    for tool in unshare setpriv mount umount setsid renice; do command -v "$tool" >/dev/null || return 1; done
    # Read-only topology checks first, so a mismatch leaves no one-shot state behind.
    canary_cgroup_precheck || return 1
    canary_fresh_state_prepare "$active_sha" || return 1
    canary_deny_tools_prepare || return 1
    [[ -d $LOG_DIR && ! -L $LOG_DIR && $(stat -c %u -- "$LOG_DIR") == 0 ]] || return 1
    canary_budget_check || { log error "canary: initial workspace/log budget exceeded"; return 1; }
  fi
  if [[ ! -d $INCUS_DIR ]]; then
    (umask 022; mkdir -- "$INCUS_DIR") || return 1
    chmod 0711 -- "$INCUS_DIR" || return 1
  fi
  if [[ -L $INCUS_DIR ]] || (( (8#$(stat -c %a -- "$INCUS_DIR") & 8#001) == 0 )); then
    log error "$INCUS_DIR must be a real directory traversable by guest UIDs"
    return 1
  fi
  mkdir -p -- "$RUN_DIR/client" || return 1
  canary_cgroup_prepare || return 1
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then CANARY_RUN_OWNED=1; fi
  subid_file_ensure "$SUBID_DIR/subuid" || { canary_cgroup_stop || true; return 1; }
  subid_file_ensure "$SUBID_DIR/subgid" || { canary_cgroup_stop || true; return 1; }
  rm -f -- "$PIDFILE"
  canary_watchdog_start || { canary_cgroup_stop || true; return 1; }
  canary_guardian_start || { canary_cgroup_stop || true; return 1; }
  (
    umask 022
    cd / || exit 1
    if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
      canary_launch "$slot_real" > "$LOG_DIR/incusd.out" 2>&1 < /dev/null
      exit 1
    fi
    # shellcheck disable=SC2016  # $$ and $@ must expand in the child shell
    exec setsid env -i PATH="$slot_real/payload/tools:$SAFE_PATH" HOME="$RUN_DIR" LANG=C INCUS_DIR="$INCUS_DIR" \
      INCUS_CONF="$RUN_DIR/client" INCUS_EXEC_PATH="$slot_real/payload/bin/incusd" \
      INCUS_LXC_HOOK="$slot_real/payload/share/lxc/hooks" INCUS_SKIP_INSTANCE_TYPES=true INCUS_SECURITY_APPARMOR=false \
      bash -c 'echo $$ > "$1"; shift; exec "$@"' polyseat-launch "$PIDFILE" \
      "$slot_real/payload/bin/incusd" --group "" --logfile "$LOG_DIR/incusd.log" \
      > "$LOG_DIR/incusd.out" 2>&1 < /dev/null 9>&-
  ) &
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    timeout=$CANARY_HEALTH_TIMEOUT
  else
    timeout=$(cfg_get HEALTH_TIMEOUT 60)
    [[ $timeout =~ ^[0-9]+$ ]] || timeout=60
  fi
  deadline=$(( $(canary_monotonic_seconds) + timeout ))
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then CANARY_HEALTH_DEADLINE=$deadline; fi
  for ((i = 0; i < timeout * 2; i++)); do
    sleep 0.5
    if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
      (( $(canary_monotonic_seconds) < deadline )) || break
      canary_watchdog_check || break
      # The daemon creates its own Unix socket. Narrow its default root-group
      # mode once, before it can be used by any controller operation.
      if [[ -S $INCUS_DIR/unix.socket && ! -L $INCUS_DIR/unix.socket && \
        $(stat -c %u -- "$INCUS_DIR/unix.socket") == 0 ]]; then
        chmod 0600 -- "$INCUS_DIR/unix.socket" || break
      fi
    fi
    if health_check 2>/dev/null; then
      CANARY_HEALTH_DEADLINE=0
      log info "service started and healthy"
      return 0
    fi
    svc_pid >/dev/null || { [[ $i -gt 6 ]] && break; }
  done
  log error "service did not become healthy within ${timeout}s"
  CANARY_HEALTH_DEADLINE=0
  svc_stop daemon || true
  return 1
}

svc_stop() { # full|daemon
  local mode=$1 pid i
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    canary_cgroup_stop || return 1
    rm -f -- "$PIDFILE"
    log info "canary: bounded process trees stopped; one-shot state kept for inspection"
    return 0
  fi
  pid=$(svc_pid) || {
    rm -f -- "$PIDFILE"
    rm -f -- "$RUN_DIR/canary-watchdog.ready"
    canary_cgroup_stop
    return $?
  }
  if [[ $mode == full && -L $CURRENT ]]; then
    if validate_data_dir 2>/dev/null; then
      INCUS_CMD_TIMEOUT=150 run_incus admin shutdown --timeout 120 >/dev/null 2>&1 || log warn "graceful 'admin shutdown' failed; signalling daemon"
    else
      log warn "DATA_DIR not valid; skipping graceful instance shutdown and signalling daemon only"
    fi
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for ((i = 0; i < 60; i++)); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done
  if kill -0 "$pid" 2>/dev/null; then
    log warn "daemon did not exit; sending SIGKILL to verified pid $pid"
    kill -KILL "$pid" 2>/dev/null || true
    sleep 0.5
  fi
  rm -f -- "$PIDFILE"
  [[ $POLYSEAT_RELEASE_GATE != canary ]] || rm -f -- "$RUN_DIR/canary-watchdog.ready"
  if [[ $POLYSEAT_RELEASE_GATE == canary ]]; then
    canary_cgroup_stop || { log error "canary: cgroup hard stop failed"; return 1; }
  fi
  ! kill -0 "$pid" 2>/dev/null
}

canary_image_verify() {
  local sha=$1 image="$CURRENT/payload/share/canary/busybox.tar.gz"
  verify_bundle_files "$sha" && verify_slot "$sha" || return 1
  [[ -f $image && ! -L $image ]] || return 1
  jq -e '.files | any(.[]; .path == "payload/share/canary/busybox.tar.gz" and
    .mode == 420 and .size > 0 and .size <= 8388608)' "$(bundle_manifest "$sha")" >/dev/null || return 1
  # verify_slot has just checked this actual file against the signed manifest.
  # No caller-provided path, alias, registry download or image hash override.
}

canary_instance_containment() {
  local state namespace_pid file pid found=""
  state=$(run_incus query /1.0/instances/polyseat-canary-cpu/state) || return 1
  namespace_pid=$(jq -er '(.metadata // .).pid | select(type == "number" and . > 1 and . == floor)' <<< "$state") || return 1
  # The API returns a PID in the daemon namespace, not a host PID. Resolve it
  # using only processes in our bounded cgroup tree, then verify subordinate
  # UID mapping. An escaped/missing process cannot accidentally pass this test.
  while IFS= read -r -d '' file; do
    while IFS= read -r pid; do
      [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/status ]] || continue
      if awk -v n="$namespace_pid" '$1 == "NSpid:" && NF == 4 && $3 == n && $4 == 1 { ok=1 } END { exit !ok }' \
        "/proc/$pid/status" 2>/dev/null; then
        [[ $(< "/proc/$pid/cgroup") == "0::/${CANARY_CGROUP##*/}/daemon/"* ]] || return 1
        awk '$1 == 0 && $2 >= 100000 && $3 >= 65536 { ok=1 } END { exit !ok }' \
          "/proc/$pid/uid_map" || return 1
        found=$pid
      fi
    done < "$file"
  done < <(find "$CANARY_CGROUP/daemon" -xdev -type f -name cgroup.procs -print0)
  [[ -n $found ]] || { log error "canary: container init is not an unprivileged descendant of the bounded tree"; return 1; }
  log info "canary instance host_pid=$found namespace_pid=$namespace_pid"
}

cmd_canary_smoke() (
  # Subshell keeps the teardown trap local to this single fixed operation.
  [[ $POLYSEAT_RELEASE_GATE == canary && $# -eq 0 ]] || die $EX_BLOCKED "canary-smoke needs a canary build and takes no arguments"
  require_approval canary-smoke
  require_no_journal
  read_pointer
  [[ -n $PTR_CURRENT && $(current_sha_from_link) == "$PTR_CURRENT" ]] || die $EX_BLOCKED "no active canary bundle"
  canary_image_verify "$PTR_CURRENT" || die $EX_VERIFY "fixed CPU image or runtime bundle failed verification"
  CANARY_OPERATION=1
  trap 'rc=$?; if [[ $CANARY_RUN_OWNED -eq 1 ]]; then svc_stop full || rc=4; fi; exit "$rc"' EXIT
  svc_start || exit $EX_HEALTH
  canary_profile_guard || exit $EX_HEALTH
  log info "canary phase: storage"
  run_incus storage create default dir "source=$INCUS_DIR/storage-pools/default" || exit $EX_HEALTH
  run_incus profile device add default root disk path=/ pool=default || exit $EX_HEALTH
  canary_profile_guard || exit $EX_HEALTH
  log info "canary phase: import"
  run_incus image import "$CURRENT/payload/share/canary/busybox.tar.gz" --alias polyseat-canary-busybox || exit $EX_HEALTH
  run_incus init polyseat-canary-busybox polyseat-canary-cpu --storage default \
    --config boot.autostart=false --config security.privileged=false --config security.nesting=false || exit $EX_HEALTH
  canary_profile_guard || exit $EX_HEALTH
  for phase in start restart; do
    log info "canary phase: $phase"
    run_incus start polyseat-canary-cpu || exit $EX_HEALTH
    canary_instance_containment && canary_profile_guard && canary_budget_check || exit $EX_HEALTH
    log info "canary phase: exec"
    run_incus exec polyseat-canary-cpu -- /bin/busybox echo POLYSEAT_CANARY_OK || exit $EX_HEALTH
    log info "canary phase: stop"
    run_incus stop polyseat-canary-cpu --force --timeout 5 || exit $EX_HEALTH
  done
  log info "canary phase: delete"
  run_incus delete polyseat-canary-cpu || exit $EX_HEALTH
  run_incus image delete polyseat-canary-busybox || exit $EX_HEALTH
  canary_profile_guard && canary_budget_check || exit $EX_HEALTH
  log info "canary phase: daemon-stop"
  svc_stop full || exit $EX_HEALTH
  trap - EXIT
  printf 'PASS: fresh CPU-only canary lifecycle; state retained, no persistence claim.\n'
)

# --------------------------------------------------------- transaction ----
# Only a service that was running is restarted after a switch/restore. Starting an
# enabled service is the boot path's job (it runs once the pool is mounted); a plugin
# re-install early in boot must never fail because DATA_DIR is not available yet.
want_running_after() { # was_running
  # A canary is a bounded one-shot test, never restarted by rollback/recovery.
  [[ $POLYSEAT_RELEASE_GATE != canary ]] || return 1
  [[ $1 -eq 1 ]]
}

restore_previous() { # previous was_running : switch live state back to previous
  local previous=$1 was=$2
  svc_stop daemon || log warn "could not stop daemon during restore"
  if [[ -n $previous ]]; then
    materialize_slot "$previous" || { log error "previous bundle cannot be restored"; return 1; }
  fi
  switch_current "$previous" || return 1
  write_pointer "$previous" ""
  if [[ -n $previous ]] && want_running_after "$was"; then
    svc_start || { log error "previous bundle restored but service did not start"; return 1; }
  fi
}

prune_unreferenced() {
  local sha f
  read_pointer
  for f in "$SLOTS"/*; do
    [[ -d $f && ! -L $f ]] || continue
    sha=$(basename -- "$f")
    [[ $sha =~ $SHA_RE ]] || continue
    [[ $sha == "$PTR_CURRENT" || $sha == "$PTR_PREVIOUS" ]] && continue
    remove_slot_exact "$sha" || true
  done
  for f in "$BUNDLE_DIR"/*.tar.gz "$BUNDLE_DIR"/*.manifest.json "$BUNDLE_DIR"/*.manifest.json.sig; do
    [[ -f $f && ! -L $f ]] || continue
    sha=$(basename -- "$f")
    sha=${sha%%.*}
    [[ $sha =~ $SHA_RE ]] || continue
    [[ $sha == "$PTR_CURRENT" || $sha == "$PTR_PREVIOUS" ]] && continue
    # Slot removal needs the manifest; only drop it once no slot remains.
    [[ -d $(slot_dir "$sha") ]] && continue
    rm -f -- "$f"
  done
}

space_check_flash() { # bytes
  local need=$(( $1 / 1024 + 16384 )) have
  have=$(free_kb "$BUNDLE_DIR")
  [[ $have -ge $need ]] || { log error "insufficient flash space: need ${need}KB, have ${have}KB"; return 1; }
}

cmd_stage() { # archive manifest sig
  local archive=${1:-} manifest=${2:-} sig=${3:-} sha base file rc=0
  require_approval stage
  [[ -f $archive && ! -L $archive && -f $manifest && ! -L $manifest && -f $sig && ! -L $sig ]] ||
    die $EX_USAGE "usage: stage ARCHIVE MANIFEST SIGNATURE --approve"
  ensure_state_dirs
  sha=$(sha256sum -- "$archive" | awk '{print $1}')
  base="$BUNDLE_DIR/.incoming-$sha"
  for file in "$base.tar.gz" "$base.manifest.json" "$base.manifest.json.sig"; do
    [[ -L $file ]] && die $EX_BLOCKED "refusing symlinked scratch file"
    rm -f -- "$file"
  done
  space_check_flash "$(stat -c %s -- "$archive")" || exit $EX_SPACE
  if ! { cp -- "$archive" "$base.tar.gz" && cp -- "$manifest" "$base.manifest.json" && cp -- "$sig" "$base.manifest.json.sig"; }; then
    rm -f -- "$base.tar.gz" "$base.manifest.json" "$base.manifest.json.sig"
    die $EX_SPACE "cannot copy bundle to flash"
  fi
  sync_path "$BUNDLE_DIR"
  BUNDLE_OVERRIDE_BASE=$base
  if ! verify_bundle_files "$sha" || ! check_host_compat "$base.manifest.json"; then rc=1; fi
  BUNDLE_OVERRIDE_BASE=""
  if [[ $rc -ne 0 ]]; then
    rm -f -- "$base.tar.gz" "$base.manifest.json" "$base.manifest.json.sig"
    die $EX_VERIFY "bundle verification failed; nothing was staged"
  fi
  if ! { mv -T -- "$base.tar.gz" "$(bundle_archive "$sha")" &&
         mv -T -- "$base.manifest.json" "$(bundle_manifest "$sha")" &&
         mv -T -- "$base.manifest.json.sig" "$(bundle_sig "$sha")"; }; then
    die $EX_CORRUPT "failed to publish staged files"
  fi
  sync_path "$BUNDLE_DIR"
  log info "staged bundle $sha"
  printf '%s\n' "$sha"
}

cmd_activate() { # sha
  local target=${1:-} previous was_running=0 rc
  require_approval activate
  [[ $target =~ $SHA_RE ]] || die $EX_USAGE "usage: activate SHA256 --approve"
  ensure_state_dirs
  require_no_journal
  read_pointer
  previous=$PTR_CURRENT
  if [[ $previous == "$target" ]]; then
    log info "bundle $target is already active"
    return 0
  fi
  materialize_slot "$target"
  rc=$?
  [[ $rc -eq 0 ]] || exit "$rc"
  if [[ -n $previous ]]; then
    materialize_slot "$previous" || die $EX_VERIFY "current bundle cannot be re-verified; refusing an update without rollback target"
  fi
  svc_pid >/dev/null && was_running=1
  write_journal activating "$target" "$previous" "$was_running"
  crash_point after_journal
  if [[ $was_running -eq 1 ]]; then
    svc_stop daemon || { clear_journal; die $EX_BLOCKED "could not stop the running daemon; nothing changed"; }
  fi
  switch_current "$target" || { restore_previous "$previous" "$was_running"; clear_journal; die $EX_CORRUPT "could not switch bundle"; }
  crash_point after_switch
  write_pointer "$target" "$previous"
  crash_point after_pointer
  if want_running_after "$was_running"; then
    if ! svc_start; then
      log error "activation failed health check: rolling back"
      restore_previous "$previous" "$was_running" || log error "ROLLBACK ALSO FAILED: manual intervention required"
      clear_journal
      die $EX_HEALTH "health check failed; previous bundle restored"
    fi
    crash_point after_start
  fi
  clear_journal
  prune_unreferenced
  log info "activated bundle $target (previous: ${previous:-none})"
}

cmd_update() { # archive manifest sig
  local sha
  require_approval update
  sha=$(cmd_stage "$@" | tail -n1) || exit $?
  cmd_activate "$sha"
}

cmd_rollback() {
  local was=0 previous bad
  require_approval rollback
  ensure_state_dirs
  require_no_journal
  read_pointer
  [[ -n $PTR_CURRENT ]] || { log info "nothing to roll back"; return 0; }
  previous=$PTR_PREVIOUS bad=$PTR_CURRENT
  [[ -n $previous ]] || die $EX_BLOCKED "no previous bundle recorded"
  materialize_slot "$previous" || die $EX_VERIFY "previous bundle cannot be verified; refusing rollback"
  svc_pid >/dev/null && was=1
  write_journal rolling-back "$bad" "$previous" "$was"
  crash_point after_journal
  restore_previous "$previous" "$was" || { clear_journal; die $EX_HEALTH "rollback target did not start; state restored to previous bundle, service down"; }
  clear_journal
  prune_unreferenced
  log info "rolled back to $previous"
}

sweep_stale_incoming() {
  local stale name sha
  for stale in "$SLOTS"/.incoming-*; do
    [[ -d $stale && ! -L $stale ]] || continue
    name=$(basename -- "$stale")
    sha=${name#.incoming-}
    if [[ $sha =~ $SHA_RE ]]; then
      cleanup_stale_incoming "$sha"
    fi
    [[ ! -e $stale ]] || log warn "stale incoming slot remains: $name (undeclared content; remove manually)"
  done
}

cmd_recover() {
  local was=0
  require_approval recover
  ensure_state_dirs
  read_journal
  read_pointer
  if [[ -z $JR_PHASE ]]; then
    sweep_stale_incoming
    log info "no unfinished transaction"
    return 0
  fi
  sweep_stale_incoming
  log warn "recovering unfinished '$JR_PHASE' transaction (target ${JR_TARGET:-none}): restoring ${JR_PREVIOUS:-<none>}"
  svc_pid >/dev/null && was=1
  [[ $JR_WAS_RUNNING -eq 1 ]] && was=1
  restore_previous "$JR_PREVIOUS" "$was" || die $EX_CORRUPT "recovery failed; journal kept for inspection"
  clear_journal
  log info "recovery complete"
}

cmd_uninstall() {
  local sha f path
  require_approval uninstall
  ensure_state_dirs
  read_journal
  [[ -z $JR_PHASE ]] || die $EX_PENDING "unfinished transaction; run recover first"
  read_pointer
  svc_stop full || die $EX_BLOCKED "could not stop the daemon; uninstall aborted before any removal"
  switch_current ""
  for f in "$SLOTS"/*; do
    [[ -d $f && ! -L $f ]] || continue
    sha=$(basename -- "$f")
    [[ $sha =~ $SHA_RE ]] && remove_slot_exact "$sha"
  done
  for f in "$BUNDLE_DIR"/*; do
    [[ -f $f && ! -L $f ]] || continue
    path=$(basename -- "$f")
    sha=${path%%.*}
    if [[ $sha =~ $SHA_RE && $path =~ ^[0-9a-f]{64}\.(tar\.gz|manifest\.json|manifest\.json\.sig)$ ]] && [[ ! -d $(slot_dir "$sha") ]]; then
      rm -f -- "$f"
    fi
  done
  rm -f -- "$STATE_DIR/pointer.json" "$STATE_DIR/journal.json"
  remove_lxc_rootfs_mount
  subid_file_remove "$SUBID_DIR/subuid" || true
  subid_file_remove "$SUBID_DIR/subgid" || true
  rm -f -- "$PIDFILE"
  rmdir -- "$RUN_DIR/client" 2>/dev/null || true
  rmdir -- "$SLOTS" "$RAM_DIR" 2>/dev/null || true
  rmdir -- "$BUNDLE_DIR" "$STATE_DIR" 2>/dev/null || true
  log info "uninstalled; settings and DATA_DIR were not touched"
}

cmd_boot() {
  local rc
  ensure_state_dirs
  read_journal
  if [[ -n $JR_PHASE ]]; then
    APPROVED=1
    cmd_recover
  fi
  sweep_stale_incoming
  read_pointer
  if [[ -z $PTR_CURRENT ]]; then
    log info "boot: no bundle installed"
    return 0
  fi
  materialize_slot "$PTR_CURRENT"
  rc=$?
  [[ $rc -eq 0 ]] || die "$rc" "boot: active bundle cannot be materialized; service not started"
  switch_current "$PTR_CURRENT" || die $EX_CORRUPT "boot: cannot link active bundle"
  if [[ $(cfg_get SERVICE disabled) == enabled ]]; then
    svc_start || die $EX_HEALTH "boot: service failed to start"
  else
    log info "boot: service is disabled in settings; not starting"
  fi
}

# ----------------------------------------------------- settings/lists ----
user_cfg_json() {
  if [[ -f $CFG && ! -L $CFG ]]; then
    awk -F= '/^[A-Z_]+="?[^"]*"?$/ { v=$2; gsub(/^"|"$/, "", v); print $1 "\t" v }' "$CFG" |
      jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}'
  else
    echo '{}'
  fi
}

cmd_config_get() {
  jq -n --argjson user "$(user_cfg_json)" --slurpfile schema "$SCHEMA" '
    $schema[0] | to_entries | map(. as $e | {
      key: $e.key, type: $e.value.type, tab: $e.value.tab, title: ($e.value.title // $e.key), label: $e.value.label,
      values: ($e.value.values // null), min: ($e.value.min // null), max: ($e.value.max // null),
      locked_while_running: ($e.value.locked_while_running // false),
      default: $e.value.default, value: ($user[$e.key] // $e.value.default), user_set: ($user | has($e.key))})'
}

write_cfg_atomic() { # key=value lines on stdin
  local tmp
  mkdir -p -- "$FLASH_DIR"
  tmp=$(mktemp "$FLASH_DIR/.cfg-XXXXXX") || return 1
  cat > "$tmp"
  chmod 0600 -- "$tmp"
  sync_path "$tmp"
  if [[ -f $CFG && ! -L $CFG ]]; then cp -p -- "$CFG" "$CFG.bak" || { rm -f -- "$tmp"; return 1; }; fi
  mv -T -- "$tmp" "$CFG"
}

cmd_config_set() { # KEY=VALUE...
  local pair key value running=0 start count current
  declare -A change=()
  [[ $# -gt 0 ]] || die $EX_USAGE "usage: config-set KEY=VALUE..."
  for pair in "$@"; do
    [[ $pair =~ ^([A-Z_]+)=(.*)$ ]] || die $EX_USAGE "bad setting: expected KEY=VALUE"
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    schema_validate "$key" "$value" || die $EX_USAGE "invalid value for $key"
    change[$key]=$value
  done
  svc_pid >/dev/null 2>&1 && running=1
  for key in "${!change[@]}"; do
    current=$(cfg_get "$key" "")
    if [[ $running -eq 1 && ${change[$key]} != "$current" ]] &&
       [[ $(jq -r --arg k "$key" '.[$k].locked_while_running // false' "$SCHEMA") == true ]]; then
      die $EX_BLOCKED "$key cannot change while the service is running; stop it first"
    fi
  done
  if [[ -n ${change[DATA_DIR]+x} && -n ${change[DATA_DIR]} ]]; then
    validate_data_dir "${change[DATA_DIR]}" || die $EX_BLOCKED "DATA_DIR rejected (see log)"
  fi
  start=${change[SUBID_START]:-$(cfg_get SUBID_START 1000000)}
  count=${change[SUBID_COUNT]:-$(cfg_get SUBID_COUNT 1000000000)}
  (( start + count <= 4294967296 )) || die $EX_USAGE "SUBID range exceeds the 32-bit ID space"
  {
    echo "# Managed by polyseatctl config-set; unset keys use the plugin defaults."
    for key in $(jq -r 'keys[]' "$SCHEMA"); do
      if [[ -n ${change[$key]+x} ]]; then
        printf '%s="%s"\n' "$key" "${change[$key]}"
      elif [[ $(user_cfg_json | jq -r --arg k "$key" 'has($k)') == true ]]; then
        printf '%s="%s"\n' "$key" "$(cfg_get "$key" "")"
      fi
    done
  } | write_cfg_atomic || die $EX_CORRUPT "could not write settings"
  log info "settings updated: $(printf '%s ' "${!change[@]}")(effective at next service start)"
}

cmd_config_reset() {
  if svc_pid >/dev/null 2>&1; then die $EX_BLOCKED "stop the service before resetting settings"; fi
  printf '%s\n' "# Managed by polyseatctl config-reset; all values use the plugin defaults." | write_cfg_atomic ||
    die $EX_CORRUPT "could not write settings"
  log info "settings reset to defaults (previous file kept as polyseat-unraid.cfg.bak)"
}

cmd_list() { # read-only: staged bundles on flash
  local f sha out="[]" cur="" prev="" m
  if (read_pointer) >/dev/null 2>&1; then read_pointer; cur=$PTR_CURRENT prev=$PTR_PREVIOUS; fi
  for f in "$BUNDLE_DIR"/*.manifest.json; do
    [[ -f $f && ! -L $f ]] || continue
    sha=$(basename -- "$f" .manifest.json)
    [[ $sha =~ $SHA_RE ]] || continue
    m=$(jq -c --arg sha "$sha" --arg cur "$cur" --arg prev "$prev" \
      --argjson arch "$([[ -f $BUNDLE_DIR/$sha.tar.gz ]] && echo true || echo false)" \
      --argjson sig "$([[ -f $BUNDLE_DIR/$sha.manifest.json.sig ]] && echo true || echo false)" \
      '{sha:$sha, version:(.version // ""), incus_version:(.incus_version // ""), built_without:(.built_without // []),
        current:($sha==$cur), previous:($sha==$prev), has_archive:$arch, has_signature:$sig}' "$f" 2>/dev/null) || continue
    out=$(jq -c --argjson m "$m" '. + [$m]' <<< "$out")
  done
  printf '%s\n' "$out"
}

cmd_metrics() { # read-only
  local l1 l5 l15 cpus mt ma pid rss=null cpu=null data=null inc=null clk ticks fs
  read -r l1 l5 l15 _ < /proc/loadavg
  cpus=$(nproc)
  mt=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  ma=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
  if pid=$(svc_pid 2>/dev/null); then
    rss=$(awk '/^VmRSS:/ {print $2}' "/proc/$pid/status" 2>/dev/null || echo null)
    clk=$(getconf CLK_TCK)
    ticks=$(awk '{print $14 + $15}' "/proc/$pid/stat" 2>/dev/null || echo 0)
    cpu=$(awk -v t="$ticks" -v c="$clk" 'BEGIN {printf "%.1f", t / c}')
  else
    pid=""
  fi
  if validate_data_dir >/dev/null 2>&1; then
    fs=$(fs_type "$DATA_REAL")
    data=$(df -Pk -- "$DATA_REAL" | awk -v p="$(cfg_get DATA_DIR "")" -v fs="$fs" 'NR==2 {printf "{\"path\":\"%s\",\"fstype\":\"%s\",\"total_kb\":%s,\"free_kb\":%s}", p, fs, $2, $4}')
    if [[ -n $pid && -L $CURRENT ]]; then
      inc=$(INCUS_CMD_TIMEOUT=6 run_incus list -f json 2>/dev/null |
        jq -c '{reachable:true, total:length, running:([.[]|select(.status=="Running")]|length)}' 2>/dev/null) || inc=""
      [[ -n $inc ]] || inc='{"reachable":false}'
    fi
  fi
  jq -n --arg l1 "$l1" --arg l5 "$l5" --arg l15 "$l15" --argjson cpus "$cpus" \
    --argjson mt "${mt:-0}" --argjson ma "${ma:-0}" --arg pid "$pid" --argjson rss "${rss:-null}" \
    --argjson cpu "${cpu:-null}" --argjson data "${data:-null}" --argjson inc "${inc:-null}" '
    {load:[($l1|tonumber),($l5|tonumber),($l15|tonumber)], cpus:$cpus,
     memory:{total_kb:$mt, available_kb:$ma},
     daemon:{running:($pid!=""), pid:(if $pid=="" then null else ($pid|tonumber) end), rss_kb:$rss, cpu_seconds:$cpu},
     data_dir:$data, incus:$inc}'
}

cmd_logs() { # [controller|incusd] [lines]
  local which=${1:-controller} nlines=${2:-100} file
  [[ $nlines =~ ^[0-9]{1,3}$ && $nlines -ge 1 && $nlines -le 500 ]] || die $EX_USAGE "lines must be 1..500"
  case "$which" in
    controller) file="$LOG_DIR/$PLUGIN.log" ;;
    incusd) file="$LOG_DIR/incusd.log" ;;
    *) die $EX_USAGE "usage: logs [controller|incusd] [lines]" ;;
  esac
  [[ -f $file && ! -L $file ]] || return 0
  tail -n "$nlines" -- "$file" |
    sed -E 's/((TOKEN|PASS(WORD)?|SECRET|KEY)[A-Za-z_]*)[=:] *[^ ]+/\1=<redacted>/Ig'
}

# ------------------------------------------------------------ read-only ----
STATE_NAME=""
state_name() {
  STATE_NAME=ABSENT
  if [[ -e "$STATE_DIR/journal.json" ]]; then
    STATE_NAME=JOURNAL_PENDING
    return
  fi
  [[ -e "$STATE_DIR/pointer.json" ]] || return 0
  if ! (read_pointer) >/dev/null 2>&1; then
    STATE_NAME=CORRUPT
    return
  fi
  read_pointer
  [[ -n $PTR_CURRENT ]] || return 0
  if svc_pid >/dev/null; then STATE_NAME=RUNNING; else STATE_NAME=ACTIVE; fi
}

cmd_status() {
  local json=0 state version=""
  [[ ${1:-} == --json ]] && json=1
  state_name
  state=$STATE_NAME
  if [[ $state == JOURNAL_PENDING ]] && (read_pointer) >/dev/null 2>&1; then
    read_pointer
  fi
  if [[ -n $PTR_CURRENT && -f $(bundle_manifest "$PTR_CURRENT") ]]; then
    version=$(jq -r .version "$(bundle_manifest "$PTR_CURRENT")" 2>/dev/null || true)
  fi
  if [[ $json -eq 1 ]]; then
    jq -n --arg state "$state" --arg cur "$PTR_CURRENT" --arg prev "$PTR_PREVIOUS" --arg ver "$version" \
      --arg ctl "$CTL_VERSION" --arg gate "$POLYSEAT_RELEASE_GATE" --arg data "$(cfg_get DATA_DIR "")" \
      '{state:$state,current:$cur,previous:$prev,version:$ver,controller:$ctl,release_gate:$gate,data_dir:$data}'
  else
    printf 'state=%s\ncurrent=%s\nprevious=%s\nversion=%s\ncontroller=%s\nrelease_gate=%s\nservice_setting=%s\ndata_dir=%s\n' \
      "$state" "${PTR_CURRENT:-}" "${PTR_PREVIOUS:-}" "$version" "$CTL_VERSION" "$POLYSEAT_RELEASE_GATE" \
      "$(cfg_get SERVICE disabled)" "$(cfg_get DATA_DIR "")"
  fi
  [[ $state != CORRUPT ]] || exit $EX_CORRUPT
}

cmd_verify() { # [sha]
  local sha=${1:-} bad=0
  if [[ -z $sha ]]; then
    read_pointer
    for sha in $PTR_CURRENT $PTR_PREVIOUS; do
      if verify_bundle_files "$sha"; then printf 'OK %s\n' "$sha"; else printf 'FAIL %s\n' "$sha"; bad=1; fi
    done
    [[ -n $PTR_CURRENT ]] || echo "nothing installed"
  else
    if verify_bundle_files "$sha"; then printf 'OK %s\n' "$sha"; else printf 'FAIL %s\n' "$sha"; bad=1; fi
  fi
  [[ $bad -eq 0 ]] || exit $EX_VERIFY
}

cmd_health() {
  validate_data_dir || exit $EX_BLOCKED
  health_check || exit $EX_HEALTH
  echo healthy
}

cmd_preflight() {
  local kernel ok=1 tool
  kernel=$(uname -r | sed -E 's/^([0-9]+\.[0-9]+).*/\1/')
  chk() { if "$@"; then echo "PASS: $DESC"; else echo "FAIL: $DESC"; ok=0; fi; }
  DESC="kernel $kernel >= 6.12"; chk version_ge "$kernel" 6.12
  DESC="cgroup v2 unified hierarchy"; chk test "$(fs_type /sys/fs/cgroup)" = cgroup2fs
  DESC="user namespaces enabled"; chk test "$(cat /proc/sys/user/max_user_namespaces 2>/dev/null || echo 0)" -gt 0
  DESC="/dev/net/tun present"; chk test -c /dev/net/tun
  # One name per lookup: `command -v a b` succeeds if any one of them exists.
  for tool in newuidmap newgidmap jq tar ssh-keygen; do DESC="$tool present"; chk command -v "$tool"; done
  if [[ -s /etc/subuid ]]; then echo "INFO: /etc/subuid has entries"; else echo "INFO: /etc/subuid empty (plugin would add a managed block at service start)"; fi
  lsm_active apparmor && echo "INFO: AppArmor is active (the bundled liblxc has none: start is refused unless ACCEPT_NO_LSM=yes)"
  lsm_active selinux && echo "INFO: SELinux is active (the bundled liblxc has none: start is refused unless ACCEPT_NO_LSM=yes)"
  if [[ -e /sys/kernel/security/lsm ]]; then
    echo "INFO: LSM: $(cat /sys/kernel/security/lsm)"
  else
    echo "INFO: no LSM (no AppArmor/SELinux confinement)"
  fi
  if [[ -n $(foreign_incusd) ]]; then
    echo "WARN: an incusd that is not part of this plugin is already running"
  else
    echo "INFO: no foreign incusd"
  fi
  echo "INFO: read-only checks only; nothing was changed"
  [[ $ok -eq 1 ]] || exit $EX_BLOCKED
}

cmd_diagnose() {
  echo "== polyseatctl $CTL_VERSION (gate: $POLYSEAT_RELEASE_GATE)"
  echo "== host"
  echo "kernel=$(uname -r) glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null) unraid=$(host_unraid_version 2>/dev/null || echo unknown)"
  echo "cgroup=$(fs_type /sys/fs/cgroup) subuid_entries=$(grep -vc '^#' /etc/subuid 2>/dev/null || echo 0)"
  echo "== status"
  cmd_status
  echo "== managed processes"
  if svc_pid >/dev/null 2>&1; then echo "incusd pid=$(svc_pid)"; else echo "incusd not running (by this plugin)"; fi
  echo "== last log lines (redacted)"
  if [[ -f $LOG_DIR/$PLUGIN.log ]]; then
    tail -n 50 -- "$LOG_DIR/$PLUGIN.log" | sed -E 's/((TOKEN|PASS(WORD)?|SECRET|KEY)[A-Za-z_]*)[=:] *[^ ]+/\1=<redacted>/Ig'
  fi
}

# ----------------------------------------------------------- gpu guard ----
# Read-only decision whether ONE host-owned NVIDIA GPU may be handed to a seat
# container by device access. The plugin never rebinds a driver, loads a module,
# touches libvirt or takes a lock: everything below reads files (sysfs, /proc,
# libvirt's on-disk domain definitions and run state). A GPU that a VM owns, is
# about to own, or is being handed over is refused, never "freed".
#
# Owner integration on the inspected Tower (read-only facts, 2026-10-31): the
# GamingVM lifecycle script holds `flock -n` on this file during a hand-over and
# leaves the marker after a failed one. Absent files simply pass.
GPU_TRANSITION_LOCKS="/var/run/gamingvm-transition.lock"
GPU_TRANSITION_MARKERS="/var/run/gamingvm-transition.unhealthy"
GPU_PCI_RE='^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$'
GPU_MIN_AVAILABLE_KB=$((4 * 1024 * 1024))

host_path() { # logical absolute path -> sandbox fixture path unless a CI job addresses the real system
  if sandbox && ! ci_real_system; then printf '%s%s\n' "$ROOT" "$1"; else printf '%s\n' "$1"; fi
}

gpu_is_char() { [[ -c $1 ]] || { sandbox && ! ci_real_system && [[ -f $1 && ! -L $1 ]]; }; }

gpu_libvirt_owners() { # pci... : prints "name<TAB>xmlfile" for every defined domain with one of them as PCI hostdev
  local xml name addrs
  for xml in "$(host_path /etc/libvirt/qemu)"/*.xml; do
    [[ -f $xml && ! -L $xml ]] || continue
    addrs=$(awk '
      /<hostdev[ >]/ { h = ($0 ~ /type=.pci./) } /<\/hostdev>/ { h = 0; s = 0 }
      h && /<source>/ { s = 1 } h && /<\/source>/ { s = 0 }
      h && s && /<address / {
        d = b = sl = f = ""
        if (match($0, /domain=.0x[0-9a-fA-F]+/)) d = substr($0, RSTART + 10, RLENGTH - 10)
        if (match($0, /bus=.0x[0-9a-fA-F]+/)) b = substr($0, RSTART + 7, RLENGTH - 7)
        if (match($0, /slot=.0x[0-9a-fA-F]+/)) sl = substr($0, RSTART + 8, RLENGTH - 8)
        if (match($0, /function=.0x[0-9a-fA-F]+/)) f = substr($0, RSTART + 12, RLENGTH - 12)
        if (d != "" && b != "" && sl != "" && f != "")
          printf "%04x:%02x:%02x.%x\n", strtonum("0x" d), strtonum("0x" b), strtonum("0x" sl), strtonum("0x" f)
      }' "$xml" 2>/dev/null) || continue
    name=$(sed -n 's:.*<name>\(.*\)</name>.*:\1:p' "$xml" | head -n 1)
    [[ -n $name ]] || name=$(basename -- "$xml" .xml)
    local want
    for want in "$@"; do
      if grep -qxF -- "$want" <<< "$addrs"; then printf '%s\t%s\n' "$name" "$xml"; break; fi
    done
  done
}

gpu_domain_active() { # name : running or being started/stopped by libvirt (status file or live pid)
  local run pid
  run=$(host_path /var/run/libvirt/qemu)
  [[ -e $run/$1.xml ]] && return 0
  [[ -f $run/$1.pid ]] || return 1
  pid=$(tr -dc '0-9' < "$run/$1.pid")
  [[ -n $pid && -d $(host_path "/proc/$pid") ]]
}

gpu_lock_held() { # path : another process holds a flock/POSIX lock on exactly this file (read from /proc/locks)
  local f=$1 dev ino key
  [[ -e $f ]] || return 1
  read -r dev ino < <(stat -L -c '%d %i' -- "$f") || return 1
  key=$(printf '%02x:%02x:%s' $(((dev >> 8) & 0xfff)) $(((dev & 0xff) | ((dev >> 12) & 0xfff00))) "$ino")
  awk -v k="$key" '{ for (i = 1; i <= NF; i++) if ($i == k) found = 1 } END { exit !found }' "$(host_path /proc/locks)"
}

gpu_holders() { # device paths... : "pid comm cgroup devices" for every process with one of them open
  local proc fd link pid hit dev
  [[ $# -gt 0 ]] || return 0
  for proc in "$(host_path /proc)"/[0-9]*; do
    pid=${proc##*/} hit=""
    for fd in "$proc"/fd/*; do
      link=$(readlink -- "$fd" 2>/dev/null) || continue
      for dev in "$@"; do [[ $link == "$dev" ]] && hit+="${dev#/dev/},"; done
    done 2>/dev/null
    [[ -n $hit ]] || continue
    printf '%s %s %s %s\n' "$pid" "$(cat "$proc/comm" 2>/dev/null || echo '?')" \
      "$(sed -n '1s/^0:://p' "$proc/cgroup" 2>/dev/null)" "$(tr ',' '\n' <<< "${hit%,}" | sort -u | paste -sd, -)"
  done
}

cmd_gpu_preflight() { # [--pci ADDR] [--json] : read-only
  local pci="" json=0 sys dev drv group member minor info node render="" card="" owners owner name xml
  local f held vm_kb avail res=() a
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pci) pci=${2:-}; shift 2 || die $EX_USAGE "--pci needs an address" ;;
      --json) json=1; shift ;;
      *) die $EX_USAGE "gpu-preflight [--pci 0000:01:00.0] [--json]" ;;
    esac
  done
  [[ -n $pci ]] || pci=$(cfg_get GPU_PCI '')
  [[ $pci =~ $GPU_PCI_RE ]] || die $EX_USAGE "gpu-preflight needs a PCI address like 0000:01:00.0 (got '${pci}')"
  r() { res+=("$1"$'\t'"$2"$'\t'"$3"); }
  sys=$(sys_root) dev="$sys/bus/pci/devices/$pci"
  if [[ -d $dev && ! -L $dev/class ]] && [[ $(< "$dev/class") == 0x03* && $(< "$dev/vendor") == 0x10de ]]; then
    r PASS pci "$pci is an NVIDIA display controller ($(< "$dev/device"))"
  else
    r FAIL pci "$pci is absent or not an NVIDIA display controller"
  fi
  drv=none
  [[ -L $dev/driver ]] && drv=$(basename -- "$(readlink -- "$dev/driver")")
  case "$drv" in
    nvidia) r PASS driver "bound to the host nvidia driver" ;;
    vfio-pci) r FAIL driver "bound to vfio-pci: a VM owns it; the plugin never rebinds" ;;
    none) r FAIL driver "no driver bound (hand-over in progress or failed): never touched" ;;
    *) r FAIL driver "bound to unexpected driver '$drv'" ;;
  esac
  f=$(cat "$dev/driver_override" 2>/dev/null || true)
  if [[ -z $f || $f == '(null)' || $f == nvidia ]]; then r PASS override "no foreign driver_override"; else r FAIL override "driver_override=$f"; fi
  group=()
  if [[ -L $dev/iommu_group ]]; then
    for member in "$(readlink -f -- "$dev/iommu_group")"/devices/*; do
      a=$(basename -- "$member"); group+=("$a")
      f=none; [[ -L $sys/bus/pci/devices/$a/driver ]] && f=$(basename -- "$(readlink -- "$sys/bus/pci/devices/$a/driver")")
      [[ $f == vfio-pci ]] && r FAIL iommu "group member $a is bound to vfio-pci"
    done
    r INFO iommu "IOMMU group $(basename -- "$(readlink -- "$dev/iommu_group")"): ${group[*]}"
  else
    group=("$pci")
    r WARN iommu "no IOMMU group information"
  fi
  info=$(host_path "/proc/driver/nvidia/gpus/$pci/information")
  minor=$(awk -F: '/^Device Minor/ { gsub(/[ \t]/, "", $2); print $2 }' "$info" 2>/dev/null)
  if [[ $minor =~ ^[0-9]+$ ]] && ! grep -Eq '^GPU Excluded:[[:space:]]*Yes' "$info"; then
    r PASS nvproc "driver reports device minor $minor"
  else
    r FAIL nvproc "no usable /proc/driver/nvidia entry for $pci"; minor=""
  fi
  for node in /dev/nvidiactl /dev/nvidia-uvm ${minor:+"/dev/nvidia$minor"}; do
    if gpu_is_char "$(host_path "$node")"; then r PASS node "$node present"; else r FAIL node "$node missing (the plugin never creates device nodes or loads modules)"; fi
  done
  for f in "$dev"/drm/renderD* "$dev"/drm/card*; do
    [[ -e $f ]] || continue
    case "${f##*/}" in renderD*) render=/dev/dri/${f##*/} ;; card*) card=/dev/dri/${f##*/} ;; esac
  done
  if [[ -n $render ]] && gpu_is_char "$(host_path "$render")"; then r PASS drm "render node $render${card:+, card $card}"; else r FAIL drm "no DRM render node for $pci"; fi
  f=$(cat "$sys/module/nvidia_drm/parameters/modeset" 2>/dev/null || echo '?')
  if [[ $f == Y ]]; then r PASS modeset "nvidia_drm.modeset=Y (GBM for headless sway)"; else r WARN modeset "nvidia_drm.modeset=$f: wlroots on NVIDIA needs modeset=Y"; fi
  owners=$(gpu_libvirt_owners "${group[@]}")
  if [[ -z $owners ]]; then
    r INFO vm "no defined VM passes this IOMMU group through"
  fi
  while IFS=$'\t' read -r name xml; do
    [[ -n $name ]] || continue
    vm_kb=$(sed -n "s:.*<memory unit='KiB'>\([0-9]*\)</memory>.*:\1:p" "$xml" | head -n 1)
    if gpu_domain_active "$name"; then
      r FAIL vm "VM '$name' passes this GPU through and is running or being started/stopped"
    else
      r PASS vm "VM '$name' passes this GPU through and is shut off${vm_kb:+ (needs $((vm_kb / 1024)) MiB when started)}"
    fi
    f=$(host_path "/etc/libvirt/qemu/autostart/$name.xml")
    if [[ -e $f || -L $f ]]; then
      r FAIL autostart "VM '$name' owns this GPU and is set to autostart"
    fi
  done <<< "$owners"
  for f in $GPU_TRANSITION_LOCKS; do
    if gpu_lock_held "$(host_path "$f")"; then r FAIL transition "$f is locked: a GPU/VM hand-over is running"
    else r PASS transition "$f not locked"; fi
  done
  for f in $GPU_TRANSITION_MARKERS; do
    if [[ -e $(host_path "$f") ]]; then r FAIL transition "$f present: a previous hand-over failed, needs the owner"
    else r PASS transition "$f absent"; fi
  done
  held=$(gpu_holders /dev/nvidiactl /dev/nvidia-uvm ${minor:+"/dev/nvidia$minor"} ${render:+"$render"} ${card:+"$card"})
  if [[ -n $held ]]; then
    while IFS= read -r a; do r INFO holder "$a"; done <<< "$held"
    r WARN holder "the GPU is already in use by the processes above (sharing is possible, an exclusive VM start is not)"
  else
    r PASS holder "no process holds the GPU"
  fi
  if sandbox && ! ci_real_system; then
    f=$(host_path /usr/bin/nvidia-container-cli); [[ -f $f && -x $f ]] || f=""
  else
    f=$(PATH=$SAFE_PATH command -v nvidia-container-cli || true)
  fi
  if [[ -n $f ]]; then r PASS toolkit "nvidia-container-cli at $f"; else r FAIL toolkit "nvidia-container-cli missing: nvidia.runtime cannot inject the host driver"; fi
  if [[ -L $CURRENT ]]; then
    if [[ -f $CURRENT/payload/share/lxc/hooks/nvidia && ! -L $CURRENT/payload/share/lxc/hooks/nvidia ]]; then
      r PASS hook "active bundle ships the LXC nvidia hook"
    else
      r FAIL hook "active bundle has no LXC nvidia hook (bundle predates GPU support)"
    fi
  else
    r INFO hook "no active bundle to inspect"
  fi
  avail=$(awk '/^MemAvailable:/ { print $2 }' "$(host_path /proc/meminfo)" 2>/dev/null)
  if [[ $avail =~ ^[0-9]+$ && $avail -ge $GPU_MIN_AVAILABLE_KB ]]; then r PASS memory "MemAvailable $((avail / 1024)) MiB"
  else r FAIL memory "MemAvailable ${avail:-?} kB below $((GPU_MIN_AVAILABLE_KB / 1024)) MiB"; fi
  local failed=0
  for a in "${res[@]}"; do [[ ${a%%$'\t'*} == FAIL ]] && failed=1; done
  if [[ $json -eq 1 ]]; then
    printf '%s\n' "${res[@]}" | jq -R -s --arg pci "$pci" --argjson ok "$((1 - failed))" '
      { schema: 1, pci: $pci, gpu_seat_allowed: ($ok == 1), read_only: true,
        checks: (split("\n") | map(select(length > 0) | split("\t") | {status: .[0], id: .[1], detail: .[2]})) }'
  else
    for a in "${res[@]}"; do IFS=$'\t' read -r f node info <<< "$a"; printf '%s: [%s] %s\n' "$f" "$node" "$info"; done
    if [[ $failed -eq 0 ]]; then echo "VERDICT: a seat MAY use $pci by device access (read-only check, nothing changed)"
    else echo "VERDICT: a seat must NOT use $pci now (read-only check, nothing changed)"; fi
  fi
  [[ $failed -eq 0 ]] || exit $EX_BLOCKED
}

# ---------------------------------------------------------------- main ----
usage() {
  cat >&2 <<'EOF'
usage: polyseatctl COMMAND [args]
 read-only:  status [--json] | verify [SHA] | health | preflight | diagnose | version
             gpu-preflight [--pci ADDR] [--json]
             list | metrics | logs [controller|incusd] [N] | config-get
 settings:   config-set KEY=VALUE... | config-reset
 service:    start | stop | restart | boot
 canary:     canary-smoke --approve (fixed local image; one-shot CPU-only run)
 installs (need --approve): stage ARCHIVE MANIFEST SIG | activate SHA | update ARCHIVE MANIFEST SIG
                            rollback | recover | uninstall
EOF
  exit $EX_USAGE
}

main() {
  local cmd=${1:-} arg args=()
  [[ -n $cmd ]] || usage
  shift
  for arg in "$@"; do
    if [[ $arg == --approve ]]; then APPROVED=1; else args+=("$arg"); fi
  done
  init_paths
  if [[ -n $ROOT ]] && ! [[ $ROOT =~ ^/tmp/polyseat-ctl-[A-Za-z0-9_-]{6,}$ ]]; then
    die $EX_BLOCKED "POLYSEAT_ROOT must be /tmp/polyseat-ctl-*"
  fi
  case "$cmd" in
    version) echo "polyseatctl $CTL_VERSION"; return 0 ;;
    status) cmd_status "${args[@]}"; return ;;
    verify) cmd_verify "${args[@]}"; return ;;
    health) cmd_health; return ;;
    preflight) cmd_preflight; return ;;
    diagnose) cmd_diagnose; return ;;
    gpu-preflight) cmd_gpu_preflight "${args[@]}"; return ;;
    list) cmd_list; return ;;
    metrics) cmd_metrics; return ;;
    logs) cmd_logs "${args[@]}"; return ;;
    config-get) cmd_config_get; return ;;
    stage | config-set | config-reset | activate | update | rollback | recover | uninstall | start | stop | restart | boot | canary-smoke) ;;
    *) usage ;;
  esac
  require_mutation_allowed "$cmd" "${args[@]}"
  if [[ $POLYSEAT_RELEASE_GATE == canary && $cmd == stop ]]; then
    # Emergency stop must not queue behind the operation it is meant to stop.
    if [[ -d $RUN_DIR && ! -L $RUN_DIR ]]; then
      printf 'stop requested\n' > "$RUN_DIR/canary-emergency-stop"
    fi
    svc_stop full
    return
  fi
  ensure_state_dirs
  acquire_lock
  case "$cmd" in
    stage) cmd_stage "${args[@]}" ;;
    activate) cmd_activate "${args[@]}" ;;
    update) cmd_update "${args[@]}" ;;
    rollback) cmd_rollback ;;
    recover) cmd_recover ;;
    uninstall) cmd_uninstall ;;
    boot) cmd_boot ;;
    config-set) cmd_config_set "${args[@]}" ;;
    config-reset) cmd_config_reset ;;
    canary-smoke) cmd_canary_smoke "${args[@]}" ;;
    start)
      require_no_journal
      read_pointer
      [[ -n $PTR_CURRENT ]] || die $EX_BLOCKED "no bundle installed"
      materialize_slot "$PTR_CURRENT" || die $EX_VERIFY "active bundle failed verification"
      switch_current "$PTR_CURRENT"
      svc_start || exit $EX_HEALTH
      ;;
    stop) svc_stop full ;;
    restart)
      require_no_journal
      svc_stop daemon
      svc_start || exit $EX_HEALTH
      ;;
  esac
}

main "$@"
