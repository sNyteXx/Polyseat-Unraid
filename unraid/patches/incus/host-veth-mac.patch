+	// Polyseat: give the host-side end a fixed fe: MAC, as libvirt does for VM taps. A Linux bridge whose address
+	// was never set explicitly takes the lowest MAC among its ports, so a random host-side MAC below the uplink's
+	// became the bridge's own MAC while the instance ran (Tower run 9, 2026-10-31). fe:... is never the lowest.
+	hostMAC := make(net.HardwareAddr, 6)
+	if len(veth.Peer.Address) == 6 {
+		copy(hostMAC, veth.Peer.Address)
+	} else {
+		_, err = rand.Read(hostMAC)
+		if err != nil {
+			return "", 0, fmt.Errorf("Failed generating the host-side MAC address: %w", err)
+		}
+	}
+
+	hostMAC[0] = 0xfe
+	veth.Address = hostMAC
