[Unit]
Description=polyseat: headless Sway session
After=pipewire.service wireplumber.service

[Service]
Type=simple
# CPU profile defaults. A GPU profile arrives as ~/.config/systemd/user/polyseat-sway.service.d/20-gpu.conf,
# written by polyseat-profile, because the vendor variables differ per machine.
Environment=WLR_BACKENDS=headless
Environment=WLR_RENDERER=pixman
Environment=WLR_HEADLESS_OUTPUTS=1
Environment=LIBSEAT_BACKEND=noop
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=SDL_JOYSTICK_DISABLE_UDEV=1
ExecStart=/usr/bin/sway
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
# Deliberately no [Install]: nothing starts this on its own.
