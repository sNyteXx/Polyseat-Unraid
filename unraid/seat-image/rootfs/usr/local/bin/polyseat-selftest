#!/bin/bash
# shellcheck disable=SC2329  # finish() and its helpers run from the EXIT trap
# polyseat-selftest desktop|nvidia|steam|steam-cpu
#
# One fixed program, run as root INSIDE the seat (incus exec <ct> -- /usr/local/bin/polyseat-selftest desktop), so that
# CI and the Unraid canary execute byte-identical checks. It starts the headless sway session and Sunshine as the player,
# looks at what they produced, then stops both again so the container can be stopped cleanly.
#
# stdout: exactly ONE JSON object (also written to /var/lib/polyseat-selftest/result.json). stderr: progress.
# Exit 0 only on verdict PASS. No package manager; writes only /var/lib/polyseat-selftest, the player's home (the
# Sunshine log, polyseat-profile's files for the GPU profile, and Steam's own files for steam*) and /run/user.
# desktop and nvidia use no network at all. steam and steam-cpu (a seat that was given eth0 on the LAN) bring the
# interface up by DHCP, check 64 and 32 bit GL on the seat's display, let Steam bootstrap and update itself and wait
# for its sign-in window. Nobody signs in. steam-cpu is the rehearsal variant without a GPU.
set -u

SELFTEST_SCHEMA=1
MODE=${1:-}
case "$MODE" in
  desktop) PROFILE=cpu STEAM=0 ;;
  nvidia) PROFILE=nvidia STEAM=0 ;;
  steam) PROFILE=nvidia STEAM=1 ;;
  steam-cpu) PROFILE=cpu STEAM=1 ;;
  *) echo 'usage: polyseat-selftest desktop|nvidia|steam|steam-cpu' >&2; exit 2 ;;
esac
STEAM_WAIT=900
STEAM_UNIT=polyseat-steam-selftest.service

PLAYER=player
PUID=1000
RT=/run/user/$PUID
HOME_DIR=/home/$PLAYER
SUNSHINE_LOG=$HOME_DIR/.config/sunshine/sunshine.log
STATE=/var/lib/polyseat-selftest
SYSTEM_WAIT=90
T0=$(date +%s%3N)

[ "$(id -u)" = 0 ] || { echo 'polyseat-selftest must run as root inside the seat' >&2; exit 2; }
umask 022
mkdir -p "$STATE"
rm -f "$STATE"/screenshot.png "$STATE"/result.json "$STATE"/outputs.json "$STATE"/sunshine.log "$STATE"/checks.jsonl
CHECKS=$STATE/checks.jsonl
: > "$CHECKS"

# Evidence collected along the way (all strings, assembled into JSON at the end).
ev_system_state=''; ev_failed_units=''; ev_outputs=''; ev_shot_sha=''; ev_shot_w=0; ev_shot_h=0; ev_colours=0
ev_encoder_lines=''; ev_capture_lines=''; ev_sunshine_errors=''; ev_ifaces=''; ev_listeners=''; ev_nvidia=''
ev_left_procs=''
ev_lan=''; ev_vulkan=''; ev_glx64=''; ev_glx32=''; ev_steam_windows=''; ev_steam_log=''; ev_steam_gl=''; ev_steam_elf=''; ev_lib32=''
profile_switched=0
sway_started=0
steam_started=0
XDISP=''

now() { date +%s%3N; }
log() { printf '[selftest %s] %s\n' "$(( $(now) - T0 ))ms" "$*" >&2; }

# check NAME pass|fail|skip DETAIL START_MS
check() {
  jq -nc --arg name "$1" --arg status "$2" --arg detail "$3" --argjson ms "$(( $(now) - ${4:-$(now)} ))" \
    '{name: $name, status: $status, detail: $detail, ms: $ms}' >> "$CHECKS"
  log "$2: $1: $3"
}

as_player() {
  runuser -u "$PLAYER" -- env HOME="$HOME_DIR" XDG_RUNTIME_DIR="$RT" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus" "$@"
}
uctl() { as_player timeout 40 systemctl --user "$@"; }

sock() { # newest unix socket in the runtime dir matching a glob name
  find "$RT" -maxdepth 1 -type s -name "$1" -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}

swaymsg_p() {
  local s
  s=$(sock 'sway-ipc.*.sock')
  [ -n "$s" ] || return 1
  as_player env SWAYSOCK="$s" timeout 10 swaymsg "$@"
}

grim_p() {
  local w
  w=$(basename "$(sock 'wayland-[0-9]*')" 2>/dev/null)
  [ -n "$w" ] || return 1
  as_player env WAYLAND_DISPLAY="$w" timeout 20 grim "$@"
}

stop_session() {
  uctl stop polyseat-sunshine.service polyseat-sway.service >/dev/null 2>&1
  local i=0
  while [ "$i" -lt 30 ]; do
    pgrep -u "$PUID" -x 'sway|sunshine|foot|swaybar|grim' >/dev/null || return 0
    i=$((i + 1)); sleep 0.5
  done
  ev_left_procs=$(pgrep -u "$PUID" -a -x 'sway|sunshine|foot|swaybar|grim' | tr '\n' ';')
  return 1
}

steam_pids() { pgrep -u "$PUID" -f 'steamwebhelper|/ubuntu12_(32|64)/|/Steam/steam\.sh|^/usr/bin/steam|^/bin/sh /usr/bin/steam'; }

stop_steam() {
  local i=0
  as_player env DISPLAY="$XDISP" timeout 30 steam -shutdown >/dev/null 2>&1
  while [ "$i" -lt 40 ] && [ -n "$(steam_pids)" ]; do i=$((i + 1)); sleep 0.5; done
  uctl stop "$STEAM_UNIT" >/dev/null 2>&1
  i=0
  while [ "$i" -lt 30 ] && [ -n "$(steam_pids)" ]; do i=$((i + 1)); sleep 0.5; done
  ev_left_procs="$ev_left_procs$(steam_pids | xargs -r ps -o pid=,comm= -p 2>/dev/null | tr '\n' ';')"
  [ -z "$(steam_pids)" ]
}

finish() { # emits the JSON and exits; called once
  trap - EXIT
  if [ "$steam_started" = 1 ]; then
    t=$(now)
    ev_steam_log=$( { tail -n 25 "$HOME_DIR/.local/share/Steam/logs/bootstrap_log.txt" 2>/dev/null
      journalctl --no-pager -q -o cat -n 40 "_SYSTEMD_USER_UNIT=$STEAM_UNIT" 2>/dev/null; } | cut -c1-300)
    if stop_steam; then check steam-stop pass 'every Steam process is gone' "$t"
    else check steam-stop fail "still running: $ev_left_procs" "$t"; fi
  fi
  if [ "$sway_started" = 1 ]; then
    t=$(now)
    if stop_session; then check stop-session pass 'sunshine, sway and their children are gone' "$t"
    else check stop-session fail "still running: $ev_left_procs" "$t"; fi
  fi
  if [ "$profile_switched" = 1 ]; then
    polyseat-profile cpu >/dev/null 2>&1 || true
  fi
  local verdict=PASS reason=''
  if jq -e -s 'any(.[]; .status == "fail")' "$CHECKS" >/dev/null; then
    verdict=FAIL
    reason=$(jq -r -s 'map(select(.status == "fail")) | .[0] | "\(.name): \(.detail)"' "$CHECKS")
  fi
  local lines='split("\n") | map(select(length > 0))'
  jq -n --argjson schema "$SELFTEST_SCHEMA" --arg mode "$MODE" --arg profile "$PROFILE" --arg verdict "$verdict" \
    --arg reason "$reason" --argjson total_ms "$(( $(now) - T0 ))" --slurpfile checks "$CHECKS" \
    --arg system_state "$ev_system_state" --arg failed_units "$ev_failed_units" --arg outputs "$ev_outputs" \
    --arg shot_sha "$ev_shot_sha" --argjson shot_w "$ev_shot_w" --argjson shot_h "$ev_shot_h" \
    --argjson colours "$ev_colours" --arg encoder "$ev_encoder_lines" --arg capture "$ev_capture_lines" \
    --arg serrors "$ev_sunshine_errors" --arg ifaces "$ev_ifaces" --arg listeners "$ev_listeners" \
    --arg nvidia "$ev_nvidia" --arg left "$ev_left_procs" \
    --arg lan "$ev_lan" --arg glx64 "$ev_glx64" --arg glx32 "$ev_glx32" --arg lib32 "$ev_lib32" --arg vk "$ev_vulkan" \
    --arg swin "$ev_steam_windows" --arg slog "$ev_steam_log" --arg sgl "$ev_steam_gl" --arg self "$ev_steam_elf" \
    "{schema: \$schema, mode: \$mode, profile: \$profile, verdict: \$verdict, reason: \$reason, total_ms: \$total_ms,
      checks: \$checks,
      evidence: {
        system_state: \$system_state, failed_units: (\$failed_units | $lines),
        sway_outputs: (\$outputs | $lines),
        screenshot: {path: \"$STATE/screenshot.png\", sha256: \$shot_sha, width: \$shot_w, height: \$shot_h, distinct_colours: \$colours},
        sunshine: {encoder_lines: (\$encoder | $lines), capture_lines: (\$capture | $lines), error_lines: (\$serrors | $lines)},
        network: {interfaces: (\$ifaces | $lines), listeners: (\$listeners | $lines)},
        nvidia_smi: (\$nvidia | $lines),
        lan: (\$lan | $lines),
        gl: {glx64: (\$glx64 | $lines), glx32: (\$glx32 | $lines), nvidia_lib32: (\$lib32 | $lines), vulkan: (\$vk | $lines)},
        steam: {windows: (\$swin | $lines), log_tail: (\$slog | $lines), nvidia_gl_mapped: (\$sgl | $lines),
          processes_elf: (\$self | $lines)},
        processes_left: (\$left | split(\";\") | map(select(length > 0)))
      }}" | tee "$STATE/result.json"
  [ "$verdict" = PASS ]
  exit $?
}
trap finish EXIT

# --- nvidia: a GPU must exist before anything is changed -----------------------------------------------------------
if [ "$PROFILE" = nvidia ]; then
  t=$(now)
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    check nvidia-gpu fail 'nvidia-smi not found in the seat: no NVIDIA userspace was injected, no GPU' "$t"
    exit 1
  fi
  ev_nvidia=$(timeout 20 nvidia-smi -L 2>&1); rc=$?
  if [ "$rc" -ne 0 ] || ! printf '%s' "$ev_nvidia" | grep -q '^GPU [0-9]'; then
    check nvidia-gpu fail "nvidia-smi -L reported no GPU (rc=$rc): $(printf '%s' "$ev_nvidia" | head -n1)" "$t"
    exit 1
  fi
  check nvidia-gpu pass "$(printf '%s' "$ev_nvidia" | head -n1)" "$t"
  profile_switched=1
  polyseat-profile nvidia >/dev/null 2>&1 || { check profile-switch fail 'polyseat-profile nvidia failed' "$t"; exit 1; }
  if [ "$STEAM" = 1 ]; then
    # Steam's client and most games are 32 bit: the driver's 32 bit userspace must have been injected (compat32).
    t=$(now)
    ev_lib32=$(for f in /usr/lib32/libGLX_nvidia.so.0 /usr/lib32/libEGL_nvidia.so.0 /usr/lib32/libnvidia-glcore.so.*; do
      [ -e "$f" ] && printf '%s elfclass=%s\n' "$f" "$(od -An -tx1 -j4 -N1 -- "$f" 2>/dev/null | tr -d ' ')"; done)
    if printf '%s\n' "$ev_lib32" | grep -q '^/usr/lib32/libGLX_nvidia.so.0 elfclass=01$'; then
      check nvidia-32bit pass "$(printf '%s\n' "$ev_lib32" | wc -l) 32 bit driver libraries in /usr/lib32" "$t"
    else
      check nvidia-32bit fail 'no 32 bit libGLX_nvidia in /usr/lib32: compat32 was not injected' "$t"; exit 1
    fi
  fi
fi

# --- 1. systemd -------------------------------------------------------------------------------------------------------
t=$(now)
# Right after `incus start` PID 1 may not answer yet (empty state), then it reports initializing/starting: keep
# polling until a final state or the deadline.
deadline=$(( $(date +%s) + SYSTEM_WAIT ))
ev_system_state=''
while [ "$(date +%s)" -lt "$deadline" ]; do
  ev_system_state=$(systemctl is-system-running 2>/dev/null)
  case "$ev_system_state" in running | degraded | stopping | offline | maintenance) break ;; esac
  sleep 1
done
ev_failed_units=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')
case "$ev_system_state" in
  running) check system-running pass 'running' "$t" ;;
  degraded) check system-running pass "degraded (failed units: $(printf '%s' "$ev_failed_units" | tr '\n' ' '))" "$t" ;;
  *) check system-running fail "state '${ev_system_state:-<no answer>}' after ${SYSTEM_WAIT}s; failed units: $(printf '%s' "$ev_failed_units" | tr '\n' ' ')" "$t"; exit 1 ;;
esac

# --- 1b. LAN (steam*): the bridged eth0, IPv4 by DHCP, a default route and DNS ------------------------------------------
if [ "$STEAM" = 1 ]; then
  t=$(now)
  [ -e /sys/class/net/eth0 ] || { check lan fail 'no eth0: the seat was given no NIC' "$t"; exit 1; }
  # Only this running copy: the image keeps networkd and resolved masked.
  systemctl unmask systemd-networkd.socket systemd-networkd.service systemd-resolved.service >/dev/null 2>&1
  ln -sfn /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
  if ! systemctl start systemd-networkd.socket systemd-networkd.service systemd-resolved.service; then
    check lan fail 'systemd-networkd/resolved did not start' "$t"; exit 1
  fi
  addr='' gw='' dns=''
  i=0
  while [ "$i" -lt 60 ]; do
    addr=$(ip -4 -o addr show dev eth0 scope global 2>/dev/null | awk '{print $4; exit}')
    gw=$(ip -4 route show default dev eth0 2>/dev/null | awk '{print $3; exit}')
    [ -n "$addr" ] && [ -n "$gw" ] && dns=$(getent ahostsv4 client-update.steamstatic.com 2>/dev/null | awk '{print $1; exit}')
    [ -n "$dns" ] && break
    i=$((i + 1)); sleep 1
  done
  ev_lan="eth0 ${addr:-none} gateway ${gw:-none}; client-update.steamstatic.com -> ${dns:-unresolved}"
  if [ -n "$addr" ] && [ -n "$gw" ] && [ -n "$dns" ]; then check lan pass "$ev_lan" "$t"
  else check lan fail "$ev_lan" "$t"; exit 1; fi
fi

# --- 2. user manager ------------------------------------------------------------------------------------------------
t=$(now)
i=0
while [ "$i" -lt 60 ]; do
  systemctl is-active --quiet "user@$PUID.service" && [ -S "$RT/bus" ] && break
  i=$((i + 1)); sleep 0.5
done
if systemctl is-active --quiet "user@$PUID.service" && [ -S "$RT/bus" ]; then
  check user-manager pass "user@$PUID.service active, $RT/bus present" "$t"
else
  check user-manager fail "user@$PUID.service not active or no session bus" "$t"; exit 1
fi

t=$(now)
got=$(polyseat-profile status)
if [ "$got" = "$PROFILE" ]; then check profile pass "$got" "$t"; else check profile fail "profile is '$got', want '$PROFILE'" "$t"; exit 1; fi

# --- 3. sway ----------------------------------------------------------------------------------------------------------
t=$(now)
sway_started=1
uctl start polyseat-sway.service || { check sway-start fail 'systemctl --user start polyseat-sway.service failed' "$t"; exit 1; }
i=0
while [ "$i" -lt 60 ]; do
  [ -n "$(sock 'sway-ipc.*.sock')" ] && [ -n "$(sock 'wayland-[0-9]*')" ] && break
  i=$((i + 1)); sleep 0.5
done
if uctl is-active --quiet polyseat-sway.service && [ -n "$(sock 'wayland-[0-9]*')" ]; then
  check sway-start pass "active, wayland socket $(basename "$(sock 'wayland-[0-9]*')")" "$t"
else
  check sway-start fail "sway not active or no wayland socket: $(uctl status polyseat-sway.service --no-pager -n 15 2>&1 | tail -n 8 | tr '\n' '|')" "$t"; exit 1
fi

# --- 4. outputs -------------------------------------------------------------------------------------------------------
t=$(now)
outputs=''
i=0
while [ "$i" -lt 20 ]; do
  outputs=$(swaymsg_p -t get_outputs 2>/dev/null) && [ "$(printf '%s' "$outputs" | jq 'length' 2>/dev/null)" -ge 1 ] 2>/dev/null && break
  i=$((i + 1)); sleep 0.5
done
printf '%s\n' "$outputs" > "$STATE/outputs.json"
ev_outputs=$(printf '%s' "$outputs" | jq -r '.[] | "\(.name) \(.current_mode.width // 0)x\(.current_mode.height // 0) active=\(.active)"' 2>/dev/null)
nout=$(printf '%s' "$outputs" | jq 'length' 2>/dev/null || echo 0)
nhead=$(printf '%s' "$outputs" | jq '[.[] | select(.name | startswith("HEADLESS-"))] | length' 2>/dev/null || echo 0)
if [ "$nout" -ge 1 ] && [ "$nout" = "$nhead" ]; then
  check headless-output pass "$nhead headless output(s): $(printf '%s' "$ev_outputs" | tr '\n' ';')" "$t"
else
  check headless-output fail "want only HEADLESS-* outputs, got: $(printf '%s' "$ev_outputs" | tr '\n' ';')" "$t"; exit 1
fi

# --- 5. screenshot ------------------------------------------------------------------------------------------------------
t=$(now)
shot=$STATE/screenshot.png
i=0; ev_colours=0
while [ "$i" -lt 20 ]; do
  grim_p - > "$shot" 2>/dev/null
  if [ "$(head -c 8 "$shot" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 89504e470d0a1a0a ]; then
    ihdr=$(od -An -tx1 -j16 -N8 "$shot" | tr -d ' \n')
    ev_shot_w=$((16#${ihdr:0:8})); ev_shot_h=$((16#${ihdr:8:8}))
    hdr=$(( 3 + ${#ev_shot_w} + 1 + ${#ev_shot_h} + 1 + 4 ))   # "P6\nW H\n255\n"
    ev_colours=$(grim_p -t ppm - 2>/dev/null | tail -c +$((hdr + 1)) | od -An -v -tx1 -w3 | sort -u -S 48M | wc -l)
    [ "$ev_colours" -ge 2 ] && break
  fi
  i=$((i + 1)); sleep 1
done
if [ "$(head -c 8 "$shot" 2>/dev/null | od -An -tx1 | tr -d ' \n')" != 89504e470d0a1a0a ]; then
  check screenshot fail 'grim did not produce a PNG' "$t"; exit 1
fi
ev_shot_sha=$(sha256sum "$shot" | cut -d' ' -f1)
if [ "$ev_shot_w" -gt 0 ] && [ "$ev_shot_h" -gt 0 ] && [ "$ev_colours" -ge 2 ]; then
  check screenshot pass "PNG ${ev_shot_w}x${ev_shot_h}, $ev_colours distinct colours, sha256 $ev_shot_sha" "$t"
else
  check screenshot fail "PNG ${ev_shot_w}x${ev_shot_h} with $ev_colours colour(s): not a drawn desktop" "$t"; exit 1
fi

# --- 6. sunshine --------------------------------------------------------------------------------------------------------
t=$(now)
if [ "$PROFILE" = nvidia ]; then want_encoder='nvenc'; else want_encoder='libx264 \[software\]'; fi
as_player sh -c ": > '$SUNSHINE_LOG'"
uctl start polyseat-sunshine.service || { check sunshine-start fail 'systemctl --user start polyseat-sunshine.service failed' "$t"; exit 1; }
i=0
while [ "$i" -lt 90 ]; do
  grep -Eq "Found H\.264 encoder: .*($want_encoder)" "$SUNSHINE_LOG" 2>/dev/null && break
  uctl is-active --quiet polyseat-sunshine.service || break
  i=$((i + 1)); sleep 0.5
done
cp "$SUNSHINE_LOG" "$STATE/sunshine.log" 2>/dev/null
ev_encoder_lines=$(grep -E 'Found (H\.264|HEVC|AV1) encoder|Trying encoder|Encoder \[' "$SUNSHINE_LOG" 2>/dev/null)
ev_capture_lines=$(grep -Ei 'wlr|wayland|screencopy|export.dmabuf|Monitor|display' "$SUNSHINE_LOG" 2>/dev/null | head -n 40)
ev_sunshine_errors=$(grep -E 'Error:|Fatal:|Warning:|Couldn.t connect to Wayland|failed to initialize' "$SUNSHINE_LOG" 2>/dev/null | head -n 40)
if ! uctl is-active --quiet polyseat-sunshine.service; then
  check sunshine-start fail "polyseat-sunshine.service not active; log tail: $(tail -n 5 "$SUNSHINE_LOG" 2>/dev/null | tr '\n' '|')" "$t"; exit 1
fi
check sunshine-start pass 'polyseat-sunshine.service active' "$t"

t=$(now)
if grep -Eq "Found H\.264 encoder: .*($want_encoder)" "$SUNSHINE_LOG" 2>/dev/null; then
  check sunshine-encoder pass "$(grep -E "Found H\.264 encoder: .*($want_encoder)" "$SUNSHINE_LOG" | head -n1)" "$t"
else
  check sunshine-encoder fail "no 'Found H.264 encoder' line matching '$want_encoder' within 45s" "$t"
fi
t=$(now)
if grep -Eq "Couldn.t connect to Wayland|Platform failed to initialize|Failed to bind to wlr" "$SUNSHINE_LOG" 2>/dev/null; then
  check sunshine-capture fail "wlr capture failed: $(grep -E "Couldn.t connect to Wayland|Platform failed to initialize|Failed to bind to wlr" "$SUNSHINE_LOG" | head -n2 | tr '\n' '|')" "$t"
elif [ -n "$ev_capture_lines" ]; then
  check sunshine-capture pass "$(printf '%s' "$ev_capture_lines" | head -n1)" "$t"
else
  check sunshine-capture fail 'no wayland/wlr line in the Sunshine log' "$t"
fi

# --- 6b. GL on the seat's X display, 64 and 32 bit (steam*) ------------------------------------------------------------
if [ "$STEAM" = 1 ]; then
  t=$(now)
  XDISP=$(find /tmp/.X11-unix -maxdepth 1 -name 'X[0-9]*' -printf '%f\n' 2>/dev/null | sed -n 's/^X\([0-9]*\)$/:\1/p' | sort | head -1)
  [ -n "$XDISP" ] || { check xwayland fail 'sway offers no X11 display (xwayland)' "$t"; exit 1; }
  WDISP=$(basename "$(sock 'wayland-[0-9]*')")
  if [ "$PROFILE" = nvidia ]; then want_gl='NVIDIA Corporation'; vendor=nvidia; else want_gl='Mesa'; vendor=mesa; fi
  as_x() { as_player env DISPLAY="$XDISP" WAYLAND_DISPLAY="$WDISP" __GLX_VENDOR_LIBRARY_NAME="$vendor" LANG=en_US.UTF-8 "$@"; }
  ev_glx64=$(as_x timeout 60 glxinfo -B 2>&1 | grep -E 'direct rendering|OpenGL (vendor|renderer|core profile version) string' | head -n 4)
  ev_glx32=$(as_x timeout 60 glxinfo32 -B 2>&1 | grep -E 'direct rendering|OpenGL (vendor|renderer|core profile version) string' | head -n 4)
  for bits in 64 32; do
    if [ "$bits" = 64 ]; then out=$ev_glx64; else out=$ev_glx32; fi
    if printf '%s\n' "$out" | grep -q "OpenGL vendor string: $want_gl" && printf '%s\n' "$out" | grep -q 'direct rendering: Yes'; then
      check "gl-$bits" pass "$(printf '%s\n' "$out" | grep 'OpenGL renderer' | head -n1)" "$t"
    else
      check "gl-$bits" fail "want direct rendering by '$want_gl' on $XDISP: $(printf '%s' "$out" | tr '\n' '|' | cut -c1-240)" "$t"; exit 1
    fi
  done

  # Vulkan (Proton/DXVK need it): the driver's manifest is pushed in by the controller, as upstream does. vkcube
  # renders real frames through a window-system surface on the seat's display. vulkaninfo cannot be used here: it
  # always probes VK_KHR_display, which needs display control (/dev/nvidia-modeset) the seat deliberately lacks, and
  # crashed (Tower run 10). A failure still lets Steam run (its client does not need Vulkan) but fails the verdict.
  if [ "$PROFILE" = nvidia ]; then
    t=$(now)
    vk_ok=0 vk_wsi=''
    for wsi in wayland xcb; do
      out=$(as_x timeout 40 vkcube --wsi "$wsi" --c 120 --suppress_popups 2>&1); rc=$?
      ev_vulkan="${ev_vulkan}[vkcube --wsi $wsi rc=$rc] $(printf '%s\n' "$out" | head -n 12)
"
      if [ "$rc" = 0 ] && printf '%s\n' "$out" | grep -q '^Selected GPU [0-9]*: NVIDIA'; then vk_ok=1 vk_wsi=$wsi; break; fi
    done
    ev_vulkan="${ev_vulkan}icd.d: $(find /usr/share/vulkan/icd.d -maxdepth 1 -printf '%f %m %u;' 2>&1)"
    if [ "$vk_ok" = 1 ]; then
      check vulkan pass "vkcube rendered 120 frames via $vk_wsi on $(printf '%s\n' "$ev_vulkan" | grep -o 'Selected GPU [0-9]*: [^,]*' | head -n1)" "$t"
    else
      check vulkan fail "vkcube did not render on an NVIDIA device: $(printf '%s' "$ev_vulkan" | grep -iE 'error|fail|selected' | head -n 3 | tr '\n' '|' | cut -c1-300)" "$t"
    fi
  fi

  # --- 6c. Steam: bootstrap, self-update over the LAN, then its sign-in window. Nobody signs in. ----------------------
  t=$(now)
  steam_started=1
  if ! as_player timeout 40 systemd-run --user --quiet --collect --unit="$STEAM_UNIT" \
       -E DISPLAY="$XDISP" -E WAYLAND_DISPLAY="$WDISP" -E __GLX_VENDOR_LIBRARY_NAME="$vendor" -E LANG=en_US.UTF-8 \
       /usr/bin/steam; then
    check steam-start fail 'systemd-run could not start Steam' "$t"; exit 1
  fi
  steam_windows() {
    swaymsg_p -t get_tree 2>/dev/null | jq -r '.. | objects | select(has("window_properties"))
      | select((.window_properties.class // "") | test("steam"; "i")) | "\(.window_properties.class)|\(.name)"' 2>/dev/null
  }
  deadline=$(( $(date +%s) + STEAM_WAIT )); stable=0; last=$(date +%s)
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if ! uctl is-active --quiet "$STEAM_UNIT"; then break; fi
    ev_steam_windows=$(steam_windows)
    if pgrep -u "$PUID" -x steamwebhelper >/dev/null && [ -n "$ev_steam_windows" ]; then
      stable=$((stable + 1)); [ "$stable" -ge 3 ] && break
    else
      stable=0
    fi
    if [ $(( $(date +%s) - last )) -ge 30 ]; then
      last=$(date +%s)
      log "steam: $(tail -n 1 "$HOME_DIR/.local/share/Steam/logs/bootstrap_log.txt" 2>/dev/null | cut -c1-160)"
    fi
    sleep 5
  done
  if [ "$stable" -ge 3 ]; then
    check steam-ui pass "steamwebhelper up; windows: $(printf '%s\n' "$ev_steam_windows" | tr '\n' ';')" "$t"
  else
    check steam-ui fail "no stable Steam window with steamwebhelper within ${STEAM_WAIT}s (unit $(uctl is-active "$STEAM_UNIT" 2>/dev/null)); windows: $(printf '%s\n' "$ev_steam_windows" | tr '\n' ';')" "$t"
    exit 1
  fi
  # Which Steam processes run as 32/64 bit, and which ones mapped NVIDIA's GL (evidence, not a gate: games are
  # proved by gl-64/gl-32 above).
  for pid in $(steam_pids); do
    ev_steam_elf="$ev_steam_elf$(ps -o comm= -p "$pid") elfclass=$(od -An -tx1 -j4 -N1 "/proc/$pid/exe" 2>/dev/null | tr -d ' ')
"
    grep -qE 'libnvidia-(glcore|eglcore)' "/proc/$pid/maps" 2>/dev/null && ev_steam_gl="$ev_steam_gl$(ps -o comm= -p "$pid")
"
  done
  ev_steam_elf=$(printf '%s' "$ev_steam_elf" | sort | uniq -c | sed 's/^ *//')
  ev_steam_gl=$(printf '%s' "$ev_steam_gl" | sort -u)
  # The screenshot the controller keeps is Steam's.
  t=$(now)
  i=0; ev_colours=0
  while [ "$i" -lt 20 ]; do
    grim_p - > "$STATE/screenshot-steam.png" 2>/dev/null
    ev_colours=$(grim_p -t ppm - 2>/dev/null | tail -c +$((3 + ${#ev_shot_w} + 1 + ${#ev_shot_h} + 1 + 4 + 1)) | od -An -v -tx1 -w3 | sort -u -S 48M | wc -l)
    [ "$ev_colours" -ge 20 ] && break
    i=$((i + 1)); sleep 1
  done
  if [ "$(head -c 8 "$STATE/screenshot-steam.png" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 89504e470d0a1a0a ] && [ "$ev_colours" -ge 20 ]; then
    mv -f "$STATE/screenshot.png" "$STATE/screenshot-desktop.png"
    cp -f "$STATE/screenshot-steam.png" "$STATE/screenshot.png"
    ev_shot_sha=$(sha256sum "$STATE/screenshot.png" | cut -d' ' -f1)
    check steam-screenshot pass "Steam on screen: $ev_colours distinct colours, sha256 $ev_shot_sha" "$t"
  else
    check steam-screenshot fail "no Steam screenshot with at least 20 colours ($ev_colours)" "$t"; exit 1
  fi
fi

# --- 7. network: only the container's own netns -----------------------------------------------------------------------
t=$(now)
if [ "$STEAM" = 1 ]; then netns_allow=eth0; else netns_allow=''; fi
ev_ifaces=$(NETNS_ALLOW=$netns_allow /usr/local/lib/polyseat/netns-classify); netns_ok=$?
hexip() { # little-endian 8 hex digits -> dotted quad
  local h=$1
  printf '%d.%d.%d.%d' "$((16#${h:6:2}))" "$((16#${h:4:2}))" "$((16#${h:2:2}))" "$((16#${h:0:2}))"
}
listeners_now() {
  local f proto addr port st
  for f in tcp tcp6 udp udp6; do
    [ -r "/proc/net/$f" ] || continue
    proto=${f%6}
    while read -r _ laddr _ st _; do
      case "$f" in tcp*) [ "$st" = 0A ] || continue ;; udp*) [ "$st" = 07 ] || continue ;; esac
      addr=${laddr%:*}; port=$((16#${laddr#*:}))
      if [ "${#addr}" = 8 ]; then addr=$(hexip "$addr"); else addr="[v6:$addr]"; fi
      printf '%s %s:%s\n' "$proto" "$addr" "$port"
    done < <(tail -n +2 "/proc/net/$f")
  done
}
i=0
while [ "$i" -lt 40 ]; do
  ev_listeners=$(listeners_now | sort -u)
  printf '%s\n' "$ev_listeners" | grep -q ':47989$' && break
  i=$((i + 1)); sleep 0.5
done
ev_listeners=$(printf '%s\n' "$ev_listeners" | sed '/^$/d')
if [ "$netns_ok" = 0 ] && printf '%s\n' "$ev_listeners" | grep -q '^tcp .*:47989$'; then
  check netns-only pass "interfaces: $ev_ifaces; $(printf '%s\n' "$ev_listeners" | wc -l) listening sockets, incl. tcp :47989" "$t"
else
  check netns-only fail "interfaces: $ev_ifaces; Sunshine tcp :47989 listening: $(printf '%s\n' "$ev_listeners" | grep -c ':47989$')" "$t"
fi

# The EXIT trap stops both services, evaluates the stop and prints the verdict.
exit 0
