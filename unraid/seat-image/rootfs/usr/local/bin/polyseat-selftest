#!/bin/bash
# shellcheck disable=SC2329  # finish() and its helpers run from the EXIT trap
# polyseat-selftest desktop|nvidia
#
# One fixed program, run as root INSIDE the seat (incus exec <ct> -- /usr/local/bin/polyseat-selftest desktop), so that
# CI and the Unraid canary execute byte-identical checks. It starts the headless sway session and Sunshine as the player,
# looks at what they produced, then stops both again so the container can be stopped cleanly.
#
# stdout: exactly ONE JSON object (also written to /var/lib/polyseat-selftest/result.json). stderr: progress.
# Exit 0 only on verdict PASS. No network, no package manager; writes only /var/lib/polyseat-selftest, the player's
# home (the Sunshine log, and polyseat-profile's files for `nvidia`) and the player's /run/user.
set -u

SELFTEST_SCHEMA=1
MODE=${1:-}
case "$MODE" in
  desktop) PROFILE=cpu ;;
  nvidia) PROFILE=nvidia ;;
  *) echo 'usage: polyseat-selftest desktop|nvidia' >&2; exit 2 ;;
esac

PLAYER=player
PUID=1000
RT=/run/user/$PUID
HOME_DIR=/home/$PLAYER
SUNSHINE_LOG=$HOME_DIR/.config/sunshine/sunshine.log
STATE=/var/lib/polyseat-selftest
SYSTEM_WAIT=90
T0=$(date +%s%3N)

[ "$(id -u)" = 0 ] || { echo 'polyseat-selftest must run as root inside the seat' >&2; exit 2; }
umask 022
mkdir -p "$STATE"
rm -f "$STATE"/screenshot.png "$STATE"/result.json "$STATE"/outputs.json "$STATE"/sunshine.log "$STATE"/checks.jsonl
CHECKS=$STATE/checks.jsonl
: > "$CHECKS"

# Evidence collected along the way (all strings, assembled into JSON at the end).
ev_system_state=''; ev_failed_units=''; ev_outputs=''; ev_shot_sha=''; ev_shot_w=0; ev_shot_h=0; ev_colours=0
ev_encoder_lines=''; ev_capture_lines=''; ev_sunshine_errors=''; ev_ifaces=''; ev_listeners=''; ev_nvidia=''
ev_left_procs=''
profile_switched=0
sway_started=0

now() { date +%s%3N; }
log() { printf '[selftest %s] %s\n' "$(( $(now) - T0 ))ms" "$*" >&2; }

# check NAME pass|fail|skip DETAIL START_MS
check() {
  jq -nc --arg name "$1" --arg status "$2" --arg detail "$3" --argjson ms "$(( $(now) - ${4:-$(now)} ))" \
    '{name: $name, status: $status, detail: $detail, ms: $ms}' >> "$CHECKS"
  log "$2: $1: $3"
}

as_player() {
  runuser -u "$PLAYER" -- env HOME="$HOME_DIR" XDG_RUNTIME_DIR="$RT" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus" "$@"
}
uctl() { as_player timeout 40 systemctl --user "$@"; }

sock() { # newest unix socket in the runtime dir matching a glob name
  find "$RT" -maxdepth 1 -type s -name "$1" -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}

swaymsg_p() {
  local s
  s=$(sock 'sway-ipc.*.sock')
  [ -n "$s" ] || return 1
  as_player env SWAYSOCK="$s" timeout 10 swaymsg "$@"
}

grim_p() {
  local w
  w=$(basename "$(sock 'wayland-[0-9]*')" 2>/dev/null)
  [ -n "$w" ] || return 1
  as_player env WAYLAND_DISPLAY="$w" timeout 20 grim "$@"
}

stop_session() {
  uctl stop polyseat-sunshine.service polyseat-sway.service >/dev/null 2>&1
  local i=0
  while [ "$i" -lt 30 ]; do
    pgrep -u "$PUID" -x 'sway|sunshine|foot|swaybar|grim' >/dev/null || return 0
    i=$((i + 1)); sleep 0.5
  done
  ev_left_procs=$(pgrep -u "$PUID" -a -x 'sway|sunshine|foot|swaybar|grim' | tr '\n' ';')
  return 1
}

finish() { # emits the JSON and exits; called once
  trap - EXIT
  if [ "$sway_started" = 1 ]; then
    t=$(now)
    if stop_session; then check stop-session pass 'sunshine, sway and their children are gone' "$t"
    else check stop-session fail "still running: $ev_left_procs" "$t"; fi
  fi
  if [ "$profile_switched" = 1 ]; then
    polyseat-profile cpu >/dev/null 2>&1 || true
  fi
  local verdict=PASS reason=''
  if jq -e -s 'any(.[]; .status == "fail")' "$CHECKS" >/dev/null; then
    verdict=FAIL
    reason=$(jq -r -s 'map(select(.status == "fail")) | .[0] | "\(.name): \(.detail)"' "$CHECKS")
  fi
  local lines='split("\n") | map(select(length > 0))'
  jq -n --argjson schema "$SELFTEST_SCHEMA" --arg mode "$MODE" --arg profile "$PROFILE" --arg verdict "$verdict" \
    --arg reason "$reason" --argjson total_ms "$(( $(now) - T0 ))" --slurpfile checks "$CHECKS" \
    --arg system_state "$ev_system_state" --arg failed_units "$ev_failed_units" --arg outputs "$ev_outputs" \
    --arg shot_sha "$ev_shot_sha" --argjson shot_w "$ev_shot_w" --argjson shot_h "$ev_shot_h" \
    --argjson colours "$ev_colours" --arg encoder "$ev_encoder_lines" --arg capture "$ev_capture_lines" \
    --arg serrors "$ev_sunshine_errors" --arg ifaces "$ev_ifaces" --arg listeners "$ev_listeners" \
    --arg nvidia "$ev_nvidia" --arg left "$ev_left_procs" \
    "{schema: \$schema, mode: \$mode, profile: \$profile, verdict: \$verdict, reason: \$reason, total_ms: \$total_ms,
      checks: \$checks,
      evidence: {
        system_state: \$system_state, failed_units: (\$failed_units | $lines),
        sway_outputs: (\$outputs | $lines),
        screenshot: {path: \"$STATE/screenshot.png\", sha256: \$shot_sha, width: \$shot_w, height: \$shot_h, distinct_colours: \$colours},
        sunshine: {encoder_lines: (\$encoder | $lines), capture_lines: (\$capture | $lines), error_lines: (\$serrors | $lines)},
        network: {interfaces: (\$ifaces | $lines), listeners: (\$listeners | $lines)},
        nvidia_smi: (\$nvidia | $lines),
        processes_left: (\$left | split(\";\") | map(select(length > 0)))
      }}" | tee "$STATE/result.json"
  [ "$verdict" = PASS ]
  exit $?
}
trap finish EXIT

# --- nvidia: a GPU must exist before anything is changed -----------------------------------------------------------
if [ "$MODE" = nvidia ]; then
  t=$(now)
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    check nvidia-gpu fail 'nvidia-smi not found in the seat: no NVIDIA userspace was injected, no GPU' "$t"
    exit 1
  fi
  ev_nvidia=$(timeout 20 nvidia-smi -L 2>&1); rc=$?
  if [ "$rc" -ne 0 ] || ! printf '%s' "$ev_nvidia" | grep -q '^GPU [0-9]'; then
    check nvidia-gpu fail "nvidia-smi -L reported no GPU (rc=$rc): $(printf '%s' "$ev_nvidia" | head -n1)" "$t"
    exit 1
  fi
  check nvidia-gpu pass "$(printf '%s' "$ev_nvidia" | head -n1)" "$t"
  profile_switched=1
  polyseat-profile nvidia >/dev/null 2>&1 || { check profile-switch fail 'polyseat-profile nvidia failed' "$t"; exit 1; }
fi

# --- 1. systemd -------------------------------------------------------------------------------------------------------
t=$(now)
timeout "$SYSTEM_WAIT" systemctl is-system-running --wait >/dev/null 2>&1
ev_system_state=$(systemctl is-system-running 2>/dev/null)
ev_failed_units=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')
case "$ev_system_state" in
  running) check system-running pass 'running' "$t" ;;
  degraded) check system-running pass "degraded (failed units: $(printf '%s' "$ev_failed_units" | tr '\n' ' '))" "$t" ;;
  *) check system-running fail "state '$ev_system_state' after ${SYSTEM_WAIT}s" "$t"; exit 1 ;;
esac

# --- 2. user manager ------------------------------------------------------------------------------------------------
t=$(now)
i=0
while [ "$i" -lt 60 ]; do
  systemctl is-active --quiet "user@$PUID.service" && [ -S "$RT/bus" ] && break
  i=$((i + 1)); sleep 0.5
done
if systemctl is-active --quiet "user@$PUID.service" && [ -S "$RT/bus" ]; then
  check user-manager pass "user@$PUID.service active, $RT/bus present" "$t"
else
  check user-manager fail "user@$PUID.service not active or no session bus" "$t"; exit 1
fi

t=$(now)
got=$(polyseat-profile status)
if [ "$got" = "$PROFILE" ]; then check profile pass "$got" "$t"; else check profile fail "profile is '$got', want '$PROFILE'" "$t"; exit 1; fi

# --- 3. sway ----------------------------------------------------------------------------------------------------------
t=$(now)
sway_started=1
uctl start polyseat-sway.service || { check sway-start fail 'systemctl --user start polyseat-sway.service failed' "$t"; exit 1; }
i=0
while [ "$i" -lt 60 ]; do
  [ -n "$(sock 'sway-ipc.*.sock')" ] && [ -n "$(sock 'wayland-[0-9]*')" ] && break
  i=$((i + 1)); sleep 0.5
done
if uctl is-active --quiet polyseat-sway.service && [ -n "$(sock 'wayland-[0-9]*')" ]; then
  check sway-start pass "active, wayland socket $(basename "$(sock 'wayland-[0-9]*')")" "$t"
else
  check sway-start fail "sway not active or no wayland socket: $(uctl status polyseat-sway.service --no-pager -n 15 2>&1 | tail -n 8 | tr '\n' '|')" "$t"; exit 1
fi

# --- 4. outputs -------------------------------------------------------------------------------------------------------
t=$(now)
outputs=''
i=0
while [ "$i" -lt 20 ]; do
  outputs=$(swaymsg_p -t get_outputs 2>/dev/null) && [ "$(printf '%s' "$outputs" | jq 'length' 2>/dev/null)" -ge 1 ] 2>/dev/null && break
  i=$((i + 1)); sleep 0.5
done
printf '%s\n' "$outputs" > "$STATE/outputs.json"
ev_outputs=$(printf '%s' "$outputs" | jq -r '.[] | "\(.name) \(.current_mode.width // 0)x\(.current_mode.height // 0) active=\(.active)"' 2>/dev/null)
nout=$(printf '%s' "$outputs" | jq 'length' 2>/dev/null || echo 0)
nhead=$(printf '%s' "$outputs" | jq '[.[] | select(.name | startswith("HEADLESS-"))] | length' 2>/dev/null || echo 0)
if [ "$nout" -ge 1 ] && [ "$nout" = "$nhead" ]; then
  check headless-output pass "$nhead headless output(s): $(printf '%s' "$ev_outputs" | tr '\n' ';')" "$t"
else
  check headless-output fail "want only HEADLESS-* outputs, got: $(printf '%s' "$ev_outputs" | tr '\n' ';')" "$t"; exit 1
fi

# --- 5. screenshot ------------------------------------------------------------------------------------------------------
t=$(now)
shot=$STATE/screenshot.png
i=0; ev_colours=0
while [ "$i" -lt 20 ]; do
  grim_p - > "$shot" 2>/dev/null
  if [ "$(head -c 8 "$shot" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 89504e470d0a1a0a ]; then
    ihdr=$(od -An -tx1 -j16 -N8 "$shot" | tr -d ' \n')
    ev_shot_w=$((16#${ihdr:0:8})); ev_shot_h=$((16#${ihdr:8:8}))
    hdr=$(( 3 + ${#ev_shot_w} + 1 + ${#ev_shot_h} + 1 + 4 ))   # "P6\nW H\n255\n"
    ev_colours=$(grim_p -t ppm - 2>/dev/null | tail -c +$((hdr + 1)) | od -An -v -tx1 -w3 | sort -u -S 48M | wc -l)
    [ "$ev_colours" -ge 2 ] && break
  fi
  i=$((i + 1)); sleep 1
done
if [ "$(head -c 8 "$shot" 2>/dev/null | od -An -tx1 | tr -d ' \n')" != 89504e470d0a1a0a ]; then
  check screenshot fail 'grim did not produce a PNG' "$t"; exit 1
fi
ev_shot_sha=$(sha256sum "$shot" | cut -d' ' -f1)
if [ "$ev_shot_w" -gt 0 ] && [ "$ev_shot_h" -gt 0 ] && [ "$ev_colours" -ge 2 ]; then
  check screenshot pass "PNG ${ev_shot_w}x${ev_shot_h}, $ev_colours distinct colours, sha256 $ev_shot_sha" "$t"
else
  check screenshot fail "PNG ${ev_shot_w}x${ev_shot_h} with $ev_colours colour(s): not a drawn desktop" "$t"; exit 1
fi

# --- 6. sunshine --------------------------------------------------------------------------------------------------------
t=$(now)
if [ "$PROFILE" = nvidia ]; then want_encoder='nvenc'; else want_encoder='libx264 \[software\]'; fi
as_player sh -c ": > '$SUNSHINE_LOG'"
uctl start polyseat-sunshine.service || { check sunshine-start fail 'systemctl --user start polyseat-sunshine.service failed' "$t"; exit 1; }
i=0
while [ "$i" -lt 90 ]; do
  grep -Eq "Found H\.264 encoder: .*($want_encoder)" "$SUNSHINE_LOG" 2>/dev/null && break
  uctl is-active --quiet polyseat-sunshine.service || break
  i=$((i + 1)); sleep 0.5
done
cp "$SUNSHINE_LOG" "$STATE/sunshine.log" 2>/dev/null
ev_encoder_lines=$(grep -E 'Found (H\.264|HEVC|AV1) encoder|Trying encoder|Encoder \[' "$SUNSHINE_LOG" 2>/dev/null)
ev_capture_lines=$(grep -Ei 'wlr|wayland|screencopy|export.dmabuf|Monitor|display' "$SUNSHINE_LOG" 2>/dev/null | head -n 40)
ev_sunshine_errors=$(grep -E 'Error:|Fatal:|Warning:|Couldn.t connect to Wayland|failed to initialize' "$SUNSHINE_LOG" 2>/dev/null | head -n 40)
if ! uctl is-active --quiet polyseat-sunshine.service; then
  check sunshine-start fail "polyseat-sunshine.service not active; log tail: $(tail -n 5 "$SUNSHINE_LOG" 2>/dev/null | tr '\n' '|')" "$t"; exit 1
fi
check sunshine-start pass 'polyseat-sunshine.service active' "$t"

t=$(now)
if grep -Eq "Found H\.264 encoder: .*($want_encoder)" "$SUNSHINE_LOG" 2>/dev/null; then
  check sunshine-encoder pass "$(grep -E "Found H\.264 encoder: .*($want_encoder)" "$SUNSHINE_LOG" | head -n1)" "$t"
else
  check sunshine-encoder fail "no 'Found H.264 encoder' line matching '$want_encoder' within 45s" "$t"
fi
t=$(now)
if grep -Eq "Couldn.t connect to Wayland|Platform failed to initialize|Failed to bind to wlr" "$SUNSHINE_LOG" 2>/dev/null; then
  check sunshine-capture fail "wlr capture failed: $(grep -E "Couldn.t connect to Wayland|Platform failed to initialize|Failed to bind to wlr" "$SUNSHINE_LOG" | head -n2 | tr '\n' '|')" "$t"
elif [ -n "$ev_capture_lines" ]; then
  check sunshine-capture pass "$(printf '%s' "$ev_capture_lines" | head -n1)" "$t"
else
  check sunshine-capture fail 'no wayland/wlr line in the Sunshine log' "$t"
fi

# --- 7. network: only the container's own netns -----------------------------------------------------------------------
t=$(now)
ev_ifaces=$(ls /sys/class/net)
hexip() { # little-endian 8 hex digits -> dotted quad
  local h=$1
  printf '%d.%d.%d.%d' "$((16#${h:6:2}))" "$((16#${h:4:2}))" "$((16#${h:2:2}))" "$((16#${h:0:2}))"
}
listeners_now() {
  local f proto addr port st
  for f in tcp tcp6 udp udp6; do
    [ -r "/proc/net/$f" ] || continue
    proto=${f%6}
    while read -r _ laddr _ st _; do
      case "$f" in tcp*) [ "$st" = 0A ] || continue ;; udp*) [ "$st" = 07 ] || continue ;; esac
      addr=${laddr%:*}; port=$((16#${laddr#*:}))
      if [ "${#addr}" = 8 ]; then addr=$(hexip "$addr"); else addr="[v6:$addr]"; fi
      printf '%s %s:%s\n' "$proto" "$addr" "$port"
    done < <(tail -n +2 "/proc/net/$f")
  done
}
i=0
while [ "$i" -lt 40 ]; do
  ev_listeners=$(listeners_now | sort -u)
  printf '%s\n' "$ev_listeners" | grep -q ':47989$' && break
  i=$((i + 1)); sleep 0.5
done
ev_listeners=$(printf '%s\n' "$ev_listeners" | sed '/^$/d')
if [ "$ev_ifaces" = lo ] && printf '%s\n' "$ev_listeners" | grep -q '^tcp .*:47989$'; then
  check netns-only pass "interfaces: lo only; $(printf '%s\n' "$ev_listeners" | wc -l) listening sockets, incl. tcp :47989" "$t"
else
  check netns-only fail "interfaces: $(printf '%s' "$ev_ifaces" | tr '\n' ' '); Sunshine tcp :47989 listening: $(printf '%s\n' "$ev_listeners" | grep -c ':47989$')" "$t"
fi

# The EXIT trap stops both services, evaluates the stop and prints the verdict.
exit 0
